import "pkg:/data/api/NetworkStatus.bs"
import "pkg:/data/api/ApiResult.bs"
import "pkg:/source/rokuCore/GlobalConfigurationManager.bs"
import "pkg:/source/rokuCore/ConfigurationProvider.bs"
import "pkg:/data/repositories/StartupStateRepositoryImpl.bs"
import "pkg:/utils/logging/Logger.bs"
namespace DataLayer
    class BaseApi
        private maxRetries as integer
        private networkStatus as object
        private timeoutMs as integer
        private globalNode as dynamic
        private sessionRepository as dynamic
        function new(maxRetries = 1 as integer, networkStatus = invalid as dynamic, timeoutMs = 30000 as integer, globalNode = invalid as dynamic, sessionRepository = invalid as dynamic)
            if maxRetries < 0 then maxRetries = 0
            m.maxRetries = maxRetries
            if timeoutMs < 1000 then timeoutMs = 1000
            m.timeoutMs = timeoutMs
            if networkStatus = invalid then networkStatus = new DataLayer.NetworkStatus()
            m.networkStatus = networkStatus
            m.globalNode = globalNode
            m.sessionRepository = sessionRepository
        end function
        function get(url as string, query = invalid as dynamic, headers = invalid as dynamic) as object
            return m.execute(url, "GET", query, invalid, headers)
        end function
        function post(url as string, body = invalid as dynamic, query = invalid as dynamic, headers = invalid as dynamic) as object
            return m.execute(url, "POST", query, body, headers)
        end function
        function put(url as string, body = invalid as dynamic, query = invalid as dynamic, headers = invalid as dynamic) as object
            return m.execute(url, "PUT", query, body, headers)
        end function
        function delete(url as string, query = invalid as dynamic, headers = invalid as dynamic) as object
            return m.execute(url, "DELETE", query, invalid, headers)
        end function

        ' Authenticated endpoints opt into centralized token restoration,
        ' expiry refresh, Registry persistence, and Authorization headers.
        function getAuthenticated(url as string, query = invalid as dynamic, headers = invalid as dynamic) as object
            return m.executeAuthenticated(url, "GET", query, invalid, headers)
        end function
        function postAuthenticated(url as string, body = invalid as dynamic, query = invalid as dynamic, headers = invalid as dynamic) as object
            return m.executeAuthenticated(url, "POST", query, body, headers)
        end function
        function putAuthenticated(url as string, body = invalid as dynamic, query = invalid as dynamic, headers = invalid as dynamic) as object
            return m.executeAuthenticated(url, "PUT", query, body, headers)
        end function
        function deleteAuthenticated(url as string, query = invalid as dynamic, headers = invalid as dynamic) as object
            return m.executeAuthenticated(url, "DELETE", query, invalid, headers)
        end function

        function restoreSession() as object
            globalNode = m.getGlobalNode()
            repository = m.getSessionRepository()
            session = repository.readUserSession()
            if session = invalid then return { status: "NO_SESSION", session: invalid }
            if session.expires <> invalid and CreateObject("roDateTime").AsSeconds() >= Val(session.expires.ToStr())
                session = m.refreshSession(globalNode, repository, session)
                if session = invalid then return { status: "EXPIRED", session: invalid }
            else
                RokuCore.SetAuthenticatedState(globalNode, session)
            end if
            return { status: "RESTORED", session: session }
        end function

        private function executeAuthenticated(url as string, method as string, query as dynamic, body as dynamic, headers as dynamic) as object
            errors = new DataLayer.ApiResult()
            globalNode = m.getGlobalNode()
            repository = m.getSessionRepository()
            if globalNode = invalid then return errors.failure("AUTHENTICATION", "Authenticated request has no runtime application state")
            if globalNode.isUserAuthenticated <> true or globalNode.authenticationState.isGuest = true
                return errors.failure("AUTHENTICATION", "This request requires an authenticated user")
            end if

            session = repository.readUserSession()
            token = RokuCore.GetRuntimeAccessToken(globalNode)
            if session = invalid or token = ""
                return errors.failure("AUTHENTICATION", "No authenticated access token is available")
            end if
            if session.expires <> invalid and CreateObject("roDateTime").AsSeconds() >= Val(session.expires.ToStr())
                session = m.refreshSession(globalNode, repository, session)
                if session = invalid then return errors.failure("AUTHENTICATION", "The saved session expired and could not be refreshed")
                token = RokuCore.GetRuntimeAccessToken(globalNode)
            end if

            authorizedHeaders = m.buildAuthorizationHeaders(globalNode, headers)
            if authorizedHeaders = invalid then return errors.failure("AUTHENTICATION", "This request requires an authenticated user")
            return m.execute(url, method, query, body, authorizedHeaders)
        end function

        function buildAuthorizationHeaders(globalNode as dynamic, headers = invalid as dynamic) as dynamic
            token = RokuCore.GetRuntimeAccessToken(globalNode)
            if token = "" then return invalid
            result = {}
            if headers <> invalid
                for each key in headers
                    result[key] = headers[key]
                end for
            end if
            result.Authorization = "Bearer " + token
            return result
        end function

        private function refreshSession(globalNode as dynamic, repository as dynamic, session as dynamic) as dynamic
            if globalNode.tokenRefreshInProgress = true
                originalToken = session.access_token
                for attempt = 0 to 350
                    Sleep(100)
                    latest = repository.readUserSession()
                    if latest <> invalid and latest.access_token <> originalToken
                        if latest.expires = invalid or CreateObject("roDateTime").AsSeconds() < Val(latest.expires.ToStr())
                            RokuCore.SetRefreshedSession(globalNode, latest)
                            return latest
                        end if
                    end if
                    if globalNode.tokenRefreshInProgress <> true then exit for
                end for
                if globalNode.tokenRefreshInProgress = true then return invalid
                latest = repository.readUserSession()
                if latest = invalid then return invalid
                if latest.expires <> invalid and CreateObject("roDateTime").AsSeconds() >= Val(latest.expires.ToStr())
                    ' The other refresh failed. This caller may make one attempt.
                else
                    RokuCore.SetRefreshedSession(globalNode, latest)
                    return latest
                end if
            end if
            globalNode.tokenRefreshInProgress = true
            apiConfig = RokuCore.GetApiConfiguration()
            resolved = globalNode.resolvedConfig
            remote = invalid
            if resolved <> invalid then remote = resolved.remote
            common = invalid
            if remote <> invalid then common = remote.common
            authType = "inplayer"
            if common <> invalid and common.authentication_type <> invalid and common.authentication_type.ToStr() <> ""
                authType = LCase(common.authentication_type.ToStr())
            end if
            provider = "custom"
            if Instr(1, authType, "cleeng") > 0
                provider = "cleeng"
            else if Instr(1, authType, "inplayer") > 0
                provider = "inplayer"
            end if

            authBases = apiConfig.authBaseUrls
            personalisation = apiConfig.personalisation
            if authBases = invalid or personalisation = invalid or personalisation[provider] = invalid
                globalNode.tokenRefreshInProgress = false
                return invalid
            end if
            baseUrl = RokuCore.ResolveEnvironmentBaseUrl(authBases[provider], m.getEnvironment(globalNode))
            endpoint = personalisation[provider].refreshToken
            if baseUrl = invalid or endpoint = invalid
                globalNode.tokenRefreshInProgress = false
                return invalid
            end if
            refreshToken = session.refresh_token
            if refreshToken = invalid or refreshToken.ToStr() = ""
                globalNode.tokenRefreshInProgress = false
                return invalid
            end if
            url = baseUrl.ToStr() + endpoint.ToStr()

            constants = globalNode.constants
            clientId = ""
            if constants <> invalid and constants.API <> invalid and constants.API.INPLAYER_CLIENT_ID <> invalid
                clientId = constants.API.INPLAYER_CLIENT_ID.ToStr()
            end if
            request = m.buildRefreshRequest(provider, refreshToken.ToStr(), clientId)
            refreshResult = m.post(url, request.body, invalid, request.headers)
            if refreshResult = invalid or not refreshResult.ok
                globalNode.tokenRefreshInProgress = false
                return invalid
            end if
            updated = repository.persistRefreshedUserSession(refreshResult.data)
            if updated = invalid
                globalNode.tokenRefreshInProgress = false
                return invalid
            end if
            RokuCore.SetRefreshedSession(globalNode, updated)
            globalNode.tokenRefreshInProgress = false
            return updated
        end function

        function buildRefreshRequest(provider as string, refreshToken as string, clientId as string) as object
            if LCase(provider) = "cleeng"
                return { body: { refreshToken: refreshToken }, headers: { "Content-Type": "application/json" } }
            end if
            form = m.formEncode({ refresh_token: refreshToken, client_id: clientId, grant_type: "refresh_token" })
            return { body: form, headers: { "Content-Type": "application/x-www-form-urlencoded" } }
        end function

        function buildRefreshUrl(provider as string, globalNode as dynamic) as dynamic
            apiConfig = RokuCore.GetApiConfiguration()
            if apiConfig = invalid or apiConfig.authBaseUrls = invalid or apiConfig.personalisation = invalid then return invalid
            baseSection = apiConfig.authBaseUrls[provider]
            endpoints = apiConfig.personalisation[provider]
            if baseSection = invalid or endpoints = invalid or endpoints.refreshToken = invalid then return invalid
            baseUrl = RokuCore.ResolveEnvironmentBaseUrl(baseSection, m.getEnvironment(globalNode))
            if baseUrl = invalid then return invalid
            return baseUrl.ToStr() + endpoints.refreshToken.ToStr()
        end function

        private function getGlobalNode() as dynamic
            if m.globalNode <> invalid then return m.globalNode
            return GetGlobalAA()
        end function

        private function getSessionRepository() as dynamic
            if m.sessionRepository <> invalid then return m.sessionRepository
            return new DataLayer.StartupStateRepositoryImpl()
        end function

        private function getEnvironment(globalNode as dynamic) as string
            if globalNode <> invalid and globalNode.environment <> invalid
                return globalNode.environment.ToStr()
            end if
            if globalNode <> invalid and globalNode.resolvedConfig <> invalid
                if globalNode.resolvedConfig.environment <> invalid
                    return globalNode.resolvedConfig.environment.ToStr()
                end if
            end if
            runtime = RokuCore.GetRuntimeConfiguration()
            if runtime <> invalid and runtime.environment <> invalid
                return runtime.environment.ToStr()
            end if
            return "prod"
        end function

        private function formEncode(values as object) as string
            encoder = CreateObject("roUrlTransfer")
            parts = []
            for each key in values
                parts.Push(encoder.Escape(key) + "=" + encoder.Escape(values[key].ToStr()))
            end for
            return parts.Join("&")
        end function

        private function execute(url as string, method as string, query as dynamic, body as dynamic, headers as dynamic) as object
            errors = new DataLayer.ApiResult()
            if url = "" then return errors.failure("CONFIGURATION", "Request URL is required")
            requestUrl = m.withQuery(url, query)
            attempts = 0
            while attempts <= m.maxRetries
                attempts = attempts + 1
                if not m.networkStatus.isOnline()
                    return errors.failure("OFFLINE", "Network link is unavailable", 0, true, attempts)
                end if
                result = m.executeOnce(requestUrl, method, body, headers, attempts)
                if result.ok or not result.retryable or attempts > m.maxRetries then return result
            end while
            return errors.failure("UNEXPECTED", "Request failed", 0, false, attempts)
        end function

        private function executeOnce(url as string, method as string, body as dynamic, headers as dynamic, attempts as integer) as object
            errors = new DataLayer.ApiResult()
            request = CreateObject("roUrlTransfer")
            request.SetUrl(url)
            request.SetCertificatesFile("common:/certs/ca-bundle.crt")
            request.InitClientCertificates()
            request.SetRequest(method)
            request.AddHeader("Accept", "application/json")
            if headers <> invalid
                for each key in headers
                    request.AddHeader(key, headers[key].ToStr())
                end for
            end if
            hasContentType = false
            if headers <> invalid
                for each headerName in headers
                    if LCase(headerName) = "content-type" then hasContentType = true
                end for
            end if
            if body <> invalid and not hasContentType then request.AddHeader("Content-Type", "application/json")
            port = CreateObject("roMessagePort")
            request.SetMessagePort(port)
            m.printServerCall(url, method, body, headers)
            started = false
            if method = "GET"
                started = request.AsyncGetToString()
            else
                started = request.AsyncPostFromString(m.serializeBody(body))
            end if
            if not started
                return errors.failure("NETWORK", "Unable to start HTTP request", 0, true, attempts)
            end if
            event = wait(m.timeoutMs, port)
            if event = invalid
                request.AsyncCancel()
                return errors.failure("TIMEOUT", "HTTP request timed out", 0, true, attempts)
            end if
            if type(event) <> "roUrlEvent"
                return errors.failure("UNEXPECTED", "Unexpected HTTP response event", 0, false, attempts)
            end if
            responseText = event.GetString()
            statusCode = event.GetResponseCode()
            if statusCode <= 0
                return errors.failure("NETWORK", "Connection was lost before an HTTP response arrived", statusCode, true, attempts)
            end if
            if responseText = invalid or responseText = ""
                if statusCode >= 200 and statusCode < 300 then return errors.failure("PARSE", "Empty response body", statusCode, false, attempts)
                return errors.failure("HTTP", "HTTP " + statusCode.ToStr(), statusCode, statusCode >= 500, attempts)
            end if
            parsed = ParseJson(responseText)
            if statusCode >= 200 and statusCode < 300
                if parsed = invalid then return errors.failure("PARSE", "Malformed JSON response", statusCode, false, attempts)
                return errors.success(parsed, statusCode, attempts)
            end if
            detail = "HTTP " + statusCode.ToStr()
            if parsed <> invalid and type(parsed) = "roAssociativeArray"
                if parsed.message <> invalid then detail = parsed.message.ToStr()
                if parsed.error <> invalid then detail = parsed.error.ToStr()
            end if
            return errors.failure("HTTP", detail, statusCode, statusCode = 408 or statusCode = 429 or statusCode >= 500, attempts, parsed)
        end function

        private function serializeBody(body as dynamic) as string
            if body = invalid then return ""
            if LCase(type(body)) = "string" or LCase(type(body)) = "rostring" then return body
            return FormatJson(body)
        end function

        private function withQuery(url as string, query as dynamic) as string
            if query = invalid then return url
            separator = "?"
            if Instr(1, url, "?") > 0 then separator = "&"
            for each key in query
                if query[key] <> invalid
                    encoder = CreateObject("roUrlTransfer")
                    url = url + separator + encoder.Escape(key) + "=" + encoder.Escape(query[key].ToStr())
                    separator = "&"
                end if
            end for
            return url
        end function

        function buildServerCallLog(url as string, method as string, body as dynamic, headers as dynamic) as string
            command = "curl -X " + UCase(method) + " -i"
            loggedHeaders = { Accept: "application/json" }
            hasContentType = false
            if headers <> invalid
                for each name in headers
                    loggedHeaders[name] = m.redactRequestText(name, headers[name].ToStr())
                    if LCase(name) = "content-type" then hasContentType = true
                end for
            end if
            if body <> invalid and not hasContentType
                loggedHeaders["Content-Type"] = "application/json"
            end if
            for each name in loggedHeaders
                command = command + " -H " + Chr(34) + name + ": " + loggedHeaders[name] + Chr(34)
            end for
            if body <> invalid
                command = command + " -d " + Chr(39) + m.redactRequestBody(body) + Chr(39)
            end if
            return command + " " + Chr(34) + m.redactSensitiveQueryParameters(url) + Chr(34)
        end function

        private function printServerCall(url as string, method as string, body as dynamic, headers as dynamic) as void
            AppLogApi(m.buildServerCallLog(url, method, body, headers))
        end function

        private function redactRequestBody(body as dynamic) as string
            serialized = m.serializeBody(body)
            parsed = ParseJson(serialized)
            if parsed <> invalid
                return FormatJson(m.redactRequestValue(parsed, ""))
            end if
            if Instr(1, serialized, "=") > 0 then return m.redactFormEncodedBody(serialized)
            return "<redacted>"
        end function

        private function redactRequestValue(value as dynamic, fieldName as string) as dynamic
            if m.isSensitiveParameterName(fieldName) then return "<redacted>"
            valueType = LCase(type(value))
            if valueType = "roassociativearray" or valueType = "associativearray"
                redacted = {}
                for each key in value
                    redacted[key] = m.redactRequestValue(value[key], key)
                end for
                return redacted
            end if
            if valueType = "roarray" or valueType = "array"
                redacted = []
                for each item in value
                    redacted.Push(m.redactRequestValue(item, ""))
                end for
                return redacted
            end if
            return value
        end function

        private function redactFormEncodedBody(body as string) as string
            parameters = body.Tokenize("&")
            redactedBody = ""
            for index = 0 to parameters.Count() - 1
                if index > 0 then redactedBody = redactedBody + "&"
                parameter = parameters[index]
                separator = Instr(1, parameter, "=")
                if separator > 0
                    name = Left(parameter, separator - 1)
                    if m.isSensitiveParameterName(name)
                        parameter = name + "=<redacted>"
                    end if
                end if
                redactedBody = redactedBody + parameter
            end for
            return redactedBody
        end function

        private function redactRequestText(name as string, value as string) as string
            if m.isSensitiveParameterName(name) then return "<redacted>"
            return value
        end function

        private function isSensitiveParameterName(name as string) as boolean
            normalized = LCase(name).Replace("-", "_")
            if normalized = "key" or normalized = "api_key" or normalized = "apikey" then return true
            sensitiveFragments = [
                "authorization", "auth_token", "access_token", "refresh_token", "id_token",
                "token", "secret", "password", "passwd", "cookie", "credential", "signature",
                "email", "username", "full_name", "phone", "mobile", "first_name", "last_name", "address", "birth",
                "app_instance_id", "device_id", "user_id", "customer_id", "account_id", "session_id",
                "activation_code", "verification_code", "auth_code"
            ]
            for each fragment in sensitiveFragments
                if Instr(1, normalized, fragment) > 0 then return true
            end for
            if Right(normalized, 4) = "_key" then return true
            return false
        end function

        function redactSensitiveQueryParameters(url as string) as string
            queryStart = Instr(1, url, "?")
            if queryStart = 0 then return url
            baseUrl = Left(url, queryStart - 1)
            parameters = Mid(url, queryStart + 1).Tokenize("&")
            redactedQuery = ""
            for index = 0 to parameters.Count() - 1
                if index > 0 then redactedQuery = redactedQuery + "&"
                separator = Instr(1, parameters[index], "=")
                parameter = parameters[index]
                if separator > 0
                    name = Left(parameter, separator - 1)
                    if m.isSensitiveParameterName(name)
                        parameter = name + "=<redacted>"
                    end if
                end if
                redactedQuery = redactedQuery + parameter
            end for
            return baseUrl + "?" + redactedQuery
        end function
    end class
end namespace

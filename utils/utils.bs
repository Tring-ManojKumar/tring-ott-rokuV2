import "pkg:/data/datasources/RegistryDataSource.bs"
import "pkg:/utils/logging/Logger.bs"

' Compatibility entry points for the existing utility callers. Preferences and
' operational values remain global; authentication metadata is namespaced per
' packaged market so builds cannot accidentally share sessions across brands.
function getRegistrySectionForKey(key as string) as dynamic
    if key = "user_token"
        registry = new Data.RegistryDataSource()
        marketId = registry.getActiveMarketId()
        if not isValidString(marketId) then return invalid
        return "Market_" + marketId + "_Auth"
    end if
    return "App_Global"
end function

function readFromRegistry(key as string, defaultValue = invalid as dynamic) as dynamic
    sectionName = getRegistrySectionForKey(key)
    if not isValidString(sectionName) then return defaultValue
    registry = new Data.RegistryDataSource()
    return registry.read(sectionName, key, defaultValue)
end function

function writeToRegistry(key as string, value as dynamic) as boolean
    sectionName = getRegistrySectionForKey(key)
    if not isValidString(sectionName) then return false
    registry = new Data.RegistryDataSource()
    return registry.write(sectionName, key, value)
end function

function deleteFromRegistry(key as string) as boolean
    sectionName = getRegistrySectionForKey(key)
    if not isValidString(sectionName) then return false
    registry = new Data.RegistryDataSource()
    return registry.remove(sectionName, key)
end function

function clearMarketAuthenticationRegistry() as boolean
    registry = new Data.RegistryDataSource()
    marketId = registry.getActiveMarketId()
    if not isValidString(marketId) then return false
    return registry.clearSection("Market_" + marketId + "_Auth")
end function

function isValidString(value as dynamic) as boolean
    return value <> invalid and (LCase(type(value)) = "rostring" or LCase(type(value)) = "string") and value <> ""
end function

function isNonBlankString(value as dynamic) as boolean
    return isValidString(value) and value.Trim() <> ""
end function

function isValidInteger(value as dynamic) as boolean
    return value <> invalid and (LCase(type(value)) = "roint" or LCase(type(value)) = "integer")
end function

function isValidBool(value as dynamic) as boolean
    return value <> invalid and (LCase(type(value)) = "roboolean" or LCase(type(value)) = "boolean" or LCase(type(value)) = "bool")
end function

function isValidUri(value as dynamic) as boolean
    return isValidString(value) and Left(value, 4) = "http"
end function

function checkBool(value as dynamic) as boolean
    if type(value) = "roString" and value = "true"
        value = true
    end if
    return isValidBool(value) and value
end function

function arrayHasItems(value as dynamic) as boolean
    return value <> invalid and (LCase(type(value)) = "roarray" or LCase(type(value)) = "array") and value.Count() > 0
end function

function arrayHasMoreThenOneItems(value as dynamic) as boolean
    return arrayHasItems(value) and value.Count() > 1
end function

function isValidAA(value as dynamic) as boolean
    return value <> invalid and (LCase(type(value)) = "roassociativearray" or LCase(type(value)) = "assocarray") and value.Count() > 0
end function

function isEqual(valueFirst as dynamic, valueSecond as dynamic) as boolean
    return valueFirst <> invalid and valueSecond <> invalid and Type(valueFirst) = Type(valueSecond) and valueFirst = valueSecond
end function

function bsTernaryOperation(condition as dynamic, trueValue as dynamic, falseValue as dynamic) as dynamic
    if condition
        return trueValue
    else
        return falseValue
    end if
end function

function getNodeFromObject(response = invalid as object) as object
    responseNode = createObject("roSGNode", "ContentNode")
    if isValidAA(response)
        responseNode.id = response.id
        responseNode.addFields(response)
        ' ContentNode already defines title and description, so addFields skips them.
        if isValidString(response.title) then responseNode.title = response.title
        if isValidString(response.description) then responseNode.description = response.description
    else if arrayHasItems(response)
        responseNode.addFields({
            content: response
        })
    end if
    return responseNode
end function

function getLabelBound(text as string, font as object) as object
    label = CreateObject("roSGNode", "Label")
    label.font = font
    label.text = text
    return label.boundingRect()
end function

function contains(value as string, key as string) as boolean
    if isValidString(value) and isValidString(key)
        return Instr(0, value, key) > 0
    end if
    return false
end function

sub showSpinner()
    m.top.getScene().showSpinner = true
end sub

sub hideSpinner()
    m.top.getScene().showSpinner = false
end sub

sub showMenu()
    m.top.getScene().showHeader = true
end sub

sub hideMenu()
    m.top.getScene().showHeader = false
end sub

sub showToastMessage(data as object)
    m.top.getScene().setToastData = data
end sub

function RoundOff(number as float) as integer
    intValue = Int(number)
    if number > (intValue + 0.5)
        return intValue + 1
    else
        return intValue
    end if
end function

function Ceil(number as float) as integer
    intValue = Int(number)
    if number > intValue
        return intValue + 1
    else
        return intValue
    end if
end function

sub hideMenuActiveStatus()
    m.top.getScene().callFunc("resetActiveMenuStatus")
end sub

sub showMenuActiveStatus()

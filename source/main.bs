import "pkg:/utils/logging/Logger.bs"
import "pkg:/source/rokuCore/GlobalConfigurationManager.bs"

sub Main()

    screen = CreateObject("roSGScreen")
    m.port = CreateObject("roMessagePort")
    screen.setMessagePort(m.port)
    RokuCore.InitializeGlobalConfiguration(screen.getGlobalNode())
    scene = screen.CreateScene("RootScene")
    screen.show()

#if isDebugBuild
    ' The centralized NavigationCoordinator owns initial focus. Avoid forcing focus here
    ' because it overrides the screen's intended focus target and breaks the app flow.
    homeScreen = scene.findNode("homeScreen")
    if homeScreen <> invalid
        AppLogDebug("Main", "Home screen mounted")
    end if
#endif

    ' vscode_rdb_on_device_component_entry

    while true
        msg = wait(0, m.port)
        if type(msg) = "roSGScreenEvent"

            if msg.isScreenClosed()
                return
            end if

        end if

    end while

end sub

<?xml version="1.0" encoding="UTF-8" ?>
<component name="OnboardingScreen" extends="Group">
    <interface>
        <field id="navigationParams" type="assocarray" onChange="onNavigationParamsChanged" />
        <field id="isReady" type="boolean" value="false" />
        <field id="frameworkSupportsInitialFocus" type="boolean" value="true" />
        <field id="frameworkLifecycleEvent" type="string" value="" />
        <field id="frameworkScreenIdentity" type="string" value="" />
        <field id="frameworkCreated" type="boolean" value="false" alwaysNotify="true" />
        <field id="frameworkInitialized" type="boolean" value="false" alwaysNotify="true" />
        <field id="frameworkPresented" type="boolean" value="false" alwaysNotify="true" />
        <field id="frameworkSuspended" type="boolean" value="false" alwaysNotify="true" />
        <field id="frameworkResumed" type="boolean" value="false" alwaysNotify="true" />
        <field id="frameworkExited" type="boolean" value="false" alwaysNotify="true" />
        <field id="frameworkDestroyed" type="boolean" value="false" alwaysNotify="true" />
        <field id="frameworkCleanupRequested" type="boolean" value="false" alwaysNotify="true" onChange="onCleanupRequested" />
        <function name="setInitialFocus" />
    </interface>
    <children>
    <Rectangle width="1920" height="1080" color="0x0C111BFF" />
    <Poster id="mediaImage" translation="[0, 0]" width="1920" height="1080" loadDisplayMode="scaleToFill" />
    <Video id="featureVideo" translation="[0, 0]" width="1920" height="1080" visible="false" enableUI="false" />
    <Poster id="gradientOverlay" translation="[0, 0]" width="1920" height="1080" uri="pkg:/assets/images/hero-gradient-option2.png" />
    <LayoutGroup id="contentColumn" translation="[100, 100]" layoutDirection="vert" horizAlignment="left" vertAlignment="top" itemSpacings="[64]">

        <LayoutGroup id="headerGroup" layoutDirection="vert" horizAlignment="left" vertAlignment="top" itemSpacings="[40]">
            <Poster id="appLogo" width="81" height="90" uri="pkg:/assets/images/app_logo.png" loadDisplayMode="scaleToFit" />

            <LayoutGroup id="titleGroup" layoutDirection="vert" horizAlignment="left" vertAlignment="top" itemSpacings="[20]">
                <Label id="screenTitle" width="756" height="65" color="0xFFFFFFFF" horizAlign="left" vertAlign="center" />
                <Label id="screenSubtitle" width="756" height="40" color="0xFFFFFF99" horizAlign="left" vertAlign="center" />
            </LayoutGroup>
        </LayoutGroup>

        <LayoutGroup id="featuresGroup" layoutDirection="vert" horizAlignment="left" vertAlignment="top" itemSpacings="[40]">

            <LayoutGroup id="featureRow1" layoutDirection="horiz" horizAlignment="left" vertAlignment="center" itemSpacings="[32]">
                <Poster id="featureIcon1" width="40" height="40" loadDisplayMode="scaleToFit" />
                <LayoutGroup id="featureText1" layoutDirection="vert" horizAlignment="left" vertAlignment="top" itemSpacings="[8]">
                    <Label id="featureTitle1" width="684" height="54" color="0xFFFFFFFF" horizAlign="left" vertAlign="center" />
                    <Label id="featureDescription1" width="684" height="36" color="0xFFFFFF99" horizAlign="left" vertAlign="center" />
                </LayoutGroup>
            </LayoutGroup>

            <LayoutGroup id="featureRow2" layoutDirection="horiz" horizAlignment="left" vertAlignment="center" itemSpacings="[32]">
                <Poster id="featureIcon2" width="40" height="40" loadDisplayMode="scaleToFit" />
                <LayoutGroup id="featureText2" layoutDirection="vert" horizAlignment="left" vertAlignment="top" itemSpacings="[8]">
                    <Label id="featureTitle2" width="684" height="54" color="0xFFFFFFFF" horizAlign="left" vertAlign="center" />
                    <Label id="featureDescription2" width="684" height="36" color="0xFFFFFF99" horizAlign="left" vertAlign="center" />
                </LayoutGroup>
            </LayoutGroup>

            <LayoutGroup id="featureRow3" layoutDirection="horiz" horizAlignment="left" vertAlignment="center" itemSpacings="[32]">
                <Poster id="featureIcon3" width="40" height="40" loadDisplayMode="scaleToFit" />
                <LayoutGroup id="featureText3" layoutDirection="vert" horizAlignment="left" vertAlignment="top" itemSpacings="[8]">
                    <Label id="featureTitle3" width="684" height="54" color="0xFFFFFFFF" horizAlign="left" vertAlign="center" />
                    <Label id="featureDescription3" width="684" height="36" color="0xFFFFFF99" horizAlign="left" vertAlign="center" />
                </LayoutGroup>
            </LayoutGroup>
        </LayoutGroup>
    </LayoutGroup>
    <AppButton id="getStartedButton" translation="[100, 908]" width="320" height="72" variant="primary" gradientPreset="primary"
    cornerRadius="36" borderWidth="0" focusedBorderWidth="0" fontSize="24"
    iconUri="pkg:/assets/images/right_chevron.png" iconWidth="24" iconHeight="24" iconGap="8" iconPosition="right" />
    
    <OnboardingCompletionTask id="completionTask" />
</children>
    <script type="text/brightscript" uri="OnboardingScreen.bs" />
</component>

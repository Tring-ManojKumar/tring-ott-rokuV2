end function

function getColorContrastRegistryKey() as string
    configID = ""
    if m.global <> invalid and m.global.urls <> invalid and m.global.urls.configID <> invalid
        configID = m.global.urls.configID.ToStr()
    end if
    return getHashValue("colorContrast" + configID)
end function

function getDefaultColorContrastState() as string
    contrastFlag = readFromRegistry(getColorContrastRegistryKey())
    if not isValidString(contrastFlag)
        contrastFlag = "false"
        writeToRegistry(getColorContrastRegistryKey(), contrastFlag)
    end if
    return contrastFlag
end function

function isColorContrastFeatureAvailable() as boolean
    flagEnabled = m.global.featureFlags <> invalid and m.global.featureFlags.settings <> invalid and isValidBool(m.global.featureFlags.settings.is_contrast_theme_enabled) and m.global.featureFlags.settings.is_contrast_theme_enabled
    return flagEnabled and isValidThemePalette(m.global.contrastThemeColors)
end function

function isValidThemePalette(palette as dynamic) as boolean
    if not isValidAA(palette) then return false
    requiredKeys = ["primary", "background", "neutral_white", "neutral_black", "neutral_800", "neutral_900"]
    for each key in requiredKeys
        if not isValidString(palette[key]) then return false
    end for
    return true
end function

function cloneThemePalette(palette as object) as object
    if not isValidAA(palette) then return {}
    return ParseJson(FormatJson(palette))
end function

function isNearWhiteColor(color as dynamic) as boolean
    if not isValidString(color) then return false
    c = LCase(color)
    return c = "#ffffff" or c = "#ffffffff" or c = "0xffffff" or c = "0xffffffff"
end function

function getFocusedOnPrimaryTextColor() as string
    if m.global <> invalid and m.global.color <> invalid and isValidString(m.global.color.button_text)
        return m.global.color.button_text
    end if
    if m.color <> invalid and isValidString(m.color.button_text)
        return m.color.button_text
    end if
    if m.color <> invalid and isValidString(m.color.neutral_white)
        return m.color.neutral_white
    end if
    return "#FFFFFF"
end function

function applyThemeColors(palette as object) as boolean
    if not isValidThemePalette(palette)
        AppLogError("Theme", "Invalid theme palette; falling back to defaults")
        if isValidThemePalette(m.global.defaultThemeColors)
            applyThemeColorsInternal(m.global.defaultThemeColors)
        end if
        return false
    end if
    applyThemeColorsInternal(palette)
    return true
end function

sub applyThemeColorsInternal(palette as object)
    colors = cloneThemePalette(palette)
    if not isValidAA(colors)
        AppLogError("Theme", "Failed to clone theme palette")
        return
    end if
    ' Avoid white-on-white when contrast primary is white and button_text is also white.
    if isNearWhiteColor(colors.primary)
        if not isValidString(colors.button_text) or isNearWhiteColor(colors.button_text)
            colors.button_text = "#000000"
        end if
    end if
    ' SceneGraph global AA fields are copied on get/set — must replace the whole AA.
    m.global.color = colors
    rev = 0
    if m.global.themeRevision <> invalid then rev = m.global.themeRevision
    m.global.themeRevision = rev + 1
    AppLogInfo("Theme", "Theme colors applied")
end sub

sub setColorContrastEnabled(enabled as boolean)
    value = "false"
    if enabled then value = "true"
    writeToRegistry(getColorContrastRegistryKey(), value)
    m.global.colorContrastEnabled = enabled
    if enabled
        contrast = m.global.contrastThemeColors
        AppLogInfo("Theme", "Color contrast enabled")
        if not applyThemeColors(contrast)
            AppLogError("Theme", "Failed to apply contrast theme colors; reverted to defaults")
            m.global.colorContrastEnabled = false
            writeToRegistry(getColorContrastRegistryKey(), "false")
        end if
    else
        AppLogInfo("Theme", "Color contrast disabled; restoring defaults")
        applyThemeColors(m.global.defaultThemeColors)
    end if
end sub

sub initColorThemeFromRemoteConfig(themeColors as object, contrastThemeColors as object)
    defaults = cloneThemePalette(themeColors)
    if not isValidThemePalette(defaults)
        defaults = cloneThemePalette(m.global.color)
    end if
    m.global.defaultThemeColors = defaults
    if isValidThemePalette(contrastThemeColors)
        m.global.contrastThemeColors = cloneThemePalette(contrastThemeColors)
    else
        m.global.contrastThemeColors = {}
    end if
    m.global.color = cloneThemePalette(defaults)
    if getDefaultColorContrastState() = "true" and isColorContrastFeatureAvailable()
        m.global.colorContrastEnabled = true
        if not applyThemeColors(m.global.contrastThemeColors)
            m.global.colorContrastEnabled = false
            writeToRegistry(getColorContrastRegistryKey(), "false")
        end if
    else
        m.global.colorContrastEnabled = false
        applyThemeColors(defaults)
    end if
end sub


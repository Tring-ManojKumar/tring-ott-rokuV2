function getExpireDay(seconds as longinteger) as string
    expireDate = CreateObject("roDateTime")
    expireDate.FromSecondsLong(seconds)
    expireDate.ToLocalTime()
    return getMonthName(expireDate.GetMonth()) + " " + expireDate.GetDayOfMonth().tostr() + ", " + expireDate.GetYear().tostr()
end function

function getMonthName(monthIndex as integer) as string
    monthNames = ["January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"]
    if monthIndex >= 1 and monthIndex <= 12
        return monthNames[monthIndex - 1]
    else
        return "Unknown"
    end if
end function

function initCap(input as string) as string
    if isValidString(input)
        endIndex = Len(input)
        firstLetter = Left(input, 1)
        ' Normalize indices
        startIndex = 1

        ' Convert to BrightScript's 1-based Mid() function
        length = endIndex - startIndex
        if length <= 0 then return ""
        return UCase(firstLetter) + Mid(input, startIndex + 1, length)
    end if
    return input
end function

function getWebUrl() as string
    if m.global.common <> invalid and isValidString(m.global.common.web_base_url)
        return m.global.common.web_base_url
    end if
    if m.global.authentication <> invalid and m.global.authentication.qr_settings <> invalid and isValidString(m.global.authentication.qr_settings.active_web_url)
        return m.global.authentication.qr_settings.active_web_url
    end if
    return "www.tringplay.media.com"
end function

function getCurrentTimeInSeconds() as longinteger
    nowSeconds = createObject("roDateTime")
    nowSeconds.ToLocalTime()
    return nowSeconds.asSeconds()
end function

function isPlayableContent(productId = "", isFree = false) as boolean
    if isFree or productId = invalid or productId = "" then return true
    if not isAuthenticationEnabled() or not isSubscriptionEnabled() then return true
    if m.global.subscription = invalid or m.global.subscription.count() = 0 then return false
    nowSeconds = getCurrentTimeInSeconds()
    for each assetID in productId.split(",")
        if not isValidString(assetID) then continue for
        accessId = assetID.Trim()
        parts = accessId.Split(":")
        if parts.count() > 1 then accessId = parts[parts.count() - 1].Trim()
        subscription = m.global.subscription[accessId]
        if subscription = invalid then subscription = m.global.subscription[assetID.Trim()]
        if subscription <> invalid
            status = ""
            if isValidString(subscription.status) then status = LCase(subscription.status)
            if status = "" or status = "active" or ((status = "cancelled" or status = "canceled") and subscription.expiresAt <> invalid and nowSeconds < subscription.expiresAt)
                return true
            end if
        end if
    end for
    return false
end function

function getProductIdKey() as string
    result = "productIds"
    if m.global.productId <> invalid
        keyName = "staging"
        if isProduction()
            keyName = "production"
        end if
        value = m.global.productId[keyName]
        if value <> invalid and isValidString(value)
            result = value
        end if
    end if
    return result
end function

function isProduction() as boolean
    if m.global.cleeng <> invalid and isValidBool(m.global.cleeng.useSandbox)
        return not m.global.cleeng.useSandbox
    else if m.global.jwp <> invalid and isValidBool(m.global.jwp.useSandbox)
        return not m.global.jwp.useSandbox
    end if
    return false
end function

sub showMenuWithBG()
    m.top.getScene().callFunc("showMenuBG")
    m.top.getScene().showHeader = true
end sub

function GetScrollMilestone(totalRows as integer, railPosition as integer) as string
    if totalRows <= 0 then return "0%"
    percent = ((railPosition + 1) * 100) / totalRows

    ' round to nearest integer for accuracy
    percent = int(percent)
    if percent >= 90
        return "90%"
    else if percent >= 75
        return "75%"
    else if percent >= 50
        return "50%"
    else if percent >= 25
        return "25%"
    end if

    return ""
end function


function isCharlesDebugBuild() as boolean
    if m.global = invalid or not isValidString(m.global.buildType) then return false
    bt = LCase(m.global.buildType)
    return bt = "stage-debug" or bt = "prod-debug"
end function

function urlProxy(url as string) as string
    if not isCharlesDebugBuild() then return url
    if not isValidString(url) then return url
    if Left(url, 4) <> "http" then return url

    proxyIp = readFromRegistry("charlesProxyIp")
    if not isValidString(proxyIp) then return url

    proxyPort = readFromRegistry("charlesProxyPort")
    if not isValidString(proxyPort)
        proxyPort = "8888"
    end if

    proxyAddress = proxyIp.Trim() + ":" + proxyPort.Trim()

    ' Make sure we have not already formatted this url
    ' This can lead to a recursive address
    if url.inStr(proxyAddress) > -1 then return url

    proxyPrefix = "http://" + proxyAddress + "/;"
    if url.inStr(proxyPrefix) = 0 then return url

    ' <HOST_RUNNING_CHARLES>:<CHARLES_PORT>;<ORIGINAL_ADDRESS>
    return proxyPrefix + url
end function

function GetImageWidth(height as Integer, aspectRatio as String) as Integer
    parts = aspectRatio.Split(":")
    if parts.Count() = 2
        widthRatio = val(parts[0])
        heightRatio = val(parts[1])
        if heightRatio > 0
            return int(height * widthRatio / heightRatio)
        end if
    end if
    ' Default to 2:3 aspect ratio if parsing fails
    return int(height * 2 / 3)
end function

function getAudioGuide() as object
    gaa = GetGlobalAA()
    if gaa.audioGuide = invalid
        gaa.audioGuide = CreateObject("roAudioGuide")
    end if
    return gaa.audioGuide
end function

sub speak(text as string, flushSpeech = true as boolean)
    if m.global <> invalid and m.global.suppressNextSpeech = true
        m.global.suppressNextSpeech = false
        return
    end if
    if not isValidString(text) then return
    guide = getAudioGuide()
    if guide <> invalid
        guide.Say(text, flushSpeech, true)
    end if
end sub

sub stopSpeech()
    guide = getAudioGuide()
    if guide <> invalid then guide.Flush()
end sub

function getContentAudioGuideText(item as object) as string
    if item = invalid then return ""
    text = ""
    if isValidString(item.title) then text = item.title
    badge = ""
    contentType = LCase(item.contentType)
    if contentType = "series"
        badge = m.global.strings.SERIES
    else if contentType = "podcast_series"
        badge = m.global.strings.SERIES
    else if item.duration > 0
        badge = formatSpokenDuration(item.duration)
    else if contentType = "livechannel" or item.isLive = true
        badge = m.global.strings.LIVE
    else if contentType = "liveevent"
        eventState = item["VCH.EventState"]
        if eventState = m.global.constants.LIVE_EVENT_STATES.PRE_LIVE or eventState = m.global.constants.LIVE_EVENT_STATES.LIVE_UNPUBLISHED or isDateInFuture(item["VCH.ScheduledStart"])
            badge = m.global.strings.SCHEDULED
        else
            badge = m.global.strings.LIVE
        end if
    end if
    if isValidString(text) and isValidString(badge) then return text + ", " + badge
    if isValidString(badge) then return badge
    return text
end function

function formatSpokenDuration(duration as longinteger) as string
    if duration <= 0 then return ""
    if duration < 60 then return duration.ToStr() + bsTernaryOperation(duration = 1, " second", " seconds")
    hours = Int(duration / 3600)
    minutes = Int((duration mod 3600) / 60)
    if (duration mod 60) > 30 then minutes++
    if minutes = 60
        hours++
        minutes = 0
    end if
    text = ""
    if hours > 0 then text = hours.ToStr() + bsTernaryOperation(hours = 1, " hour", " hours")
    if minutes > 0
        if text <> "" then text += " "
        text += minutes.ToStr() + bsTernaryOperation(minutes = 1, " minute", " minutes")
    end if
    return text
end function

function getContentMediaId(content as object) as string
    if content = invalid then return ""
    if isValidString(content.mediaId) then return content.mediaId
    if isValidString(content.mediaid) then return content.mediaid
    if isValidString(content.feedId) then return content.feedId
    return ""
end function

function isHeroPlaceholderUri(uri as string) as boolean
    if not isValidString(uri) then return true
    return uri.Instr("placeholder") > -1
end function

' Use high-contrast placeholder art when the Color Contrast accessibility setting is on.
function getThemedPlaceholderUri(defaultUri as string) as string
    if m.global = invalid or m.global.colorContrastEnabled <> true then return defaultUri
    if defaultUri = "pkg:/images/placeholder.png" then return "pkg:/images/placeholder-contrast.png"
    if defaultUri = "pkg:/images/placeholder-vertical.png" then return "pkg:/images/placeholder-vertical-contrast.png"
    if defaultUri = "pkg:/images/details_placeholder.png" then return "pkg:/images/details_placeholder_contrast.png"
    return defaultUri
end function

function getBackgroundImageUrlForMediaId(mediaId as string) as string
    if not isValidString(mediaId) or m.global = invalid or m.global.urls = invalid then return ""
    imageUrl = invalid
    if m.global.urls.doesExist("backgroundImageUrl") and isValidString(m.global.urls.backgroundImageUrl)
        imageUrl = m.global.urls.backgroundImageUrl
    else if m.global.urls.doesExist("backGroundImageUrl") and isValidString(m.global.urls.backGroundImageUrl)
        imageUrl = m.global.urls.backGroundImageUrl
    end if
    if imageUrl = invalid then return ""
    return imageUrl.Replace("{{media-id}}", mediaId)
end function

function getImageUrlFromAdditionalImageNode(imageNode as object) as string
    if imageNode = invalid then return ""
    if imageNode.image_url <> invalid and isValidString(imageNode.image_url)
        return imageNode.image_url
    else if imageNode.Image_Url <> invalid and isValidString(imageNode.Image_Url)
        return imageNode.Image_Url
    end if
    return ""
end function

function getDetailPagePosterImageUrl(response as object) as string
    if response = invalid then return ""
    imageKeys = ["poster", "Poster", "poster_thumbnail", "Poster_Thumbnail"]
    for each key in imageKeys
        imageUrl = getImageUrlFromAdditionalImageNode(response[key])
        if isValidString(imageUrl) then return imageUrl
    end for
    return ""
end function

function getDetailPageHeroImageFromImages(pageData as object) as string
    if pageData = invalid or not arrayHasItems(pageData.images) then return ""
    for each image in pageData.images
        if image.width = 1920 and isValidString(image.src) then return image.src
    end for
    return ""
end function

function getHighResolutionImageUrl(itemContent as object, targetWidth as integer) as string
    default = ""
    if itemContent <> invalid and isValidString(itemContent.image)
        default = itemContent.image
    end if
    if itemContent = invalid or type(itemContent.images) <> "roArray"
        return default
    end if
    for each item in itemContent.images
        if item.type = "image/jpeg" and item.width = targetWidth and isValidString(item.src)
            return item.src
        end if
    end for
    return default
end function

function getAlternateContentImageUrl(mediaId as string) as string
    if not isValidString(mediaId) then return ""
    if m.global = invalid or m.global.urls = invalid then return ""
    if not isValidString(m.global.urls.secondAlternateImageUrl) then return ""
    return m.global.urls.secondAlternateImageUrl.Replace("{{media-id}}", mediaId)
end function


function getSingleFeatureHeroImageUrl(itemContent as object, verticalImageCache = invalid as object) as object
    defaultPlaceHolder = getThemedPlaceholderUri("pkg:/images/placeholder.png")
    if itemContent = invalid
        return {
            uri: ""
            placeHolder: defaultPlaceHolder
            fetchedFromApi: false
        }
    end if

    imageSet = getThumbnailImageSetForContent(itemContent, verticalImageCache)
    placeHolder = imageSet.placeHolder

    if isValidString(imageSet.uri)
        return {
            uri: imageSet.uri
            placeHolder: placeHolder
            fetchedFromApi: false
        }
    end if

    constants = m.constants
    if constants = invalid and m.global <> invalid
        constants = m.global.constants
    end if
    isVerticalRail = isValidString(itemContent.railType) and constants <> invalid and (itemContent.railType = constants.RAIL_TYPES.TOPRATED or itemContent.railType = constants.RAIL_TYPES.VERTICAL or itemContent.railType = constants.RAIL_TYPES.SQUARE) and itemContent.railType <> "circular"
    if isVerticalRail
        return {
            uri: placeHolder
            placeHolder: placeHolder
            fetchedFromApi: true
        }
    end if

    heroUrl = getDetailPageHeroImageFromImages(itemContent)
    if not isValidString(heroUrl)
        heroUrl = getHighResolutionImageUrl(itemContent, 1920)
    end if
    if isValidString(heroUrl)
        return {
            uri: heroUrl
            placeHolder: placeHolder
            fetchedFromApi: false
        }
    end if

    bgUrl = getBackgroundImageUrlForMediaId(getContentMediaId(itemContent))
    if isValidString(bgUrl)
        return {
            uri: bgUrl
            placeHolder: placeHolder
            fetchedFromApi: false
        }
    end if

    mediaId = getContentMediaId(itemContent)
    if isValidString(mediaId)
        getAdditionalImageResponse(mediaId)
        return {
            uri: ""
            placeHolder: placeHolder
            fetchedFromApi: true
        }
    end if

    return {
        uri: ""
        placeHolder: placeHolder
        fetchedFromApi: false
    }
end function

function getPosterUrlFromAdditionalImageResponse(response as object) as string
    return getDetailPagePosterImageUrl(response)
end function


function getThumbnailImageSetForContent(itemContent as object, verticalImageCache = invalid as object) as object
    if itemContent = invalid
        return {
            uri: ""
            placeHolder: getThemedPlaceholderUri("pkg:/images/placeholder.png")
        }
    end if

    constants = m.constants
    if constants = invalid and m.global <> invalid
        constants = m.global.constants
    end if

    if isValidString(itemContent.railType) and constants <> invalid and (itemContent.railType = constants.RAIL_TYPES.TOPRATED or itemContent.railType = constants.RAIL_TYPES.VERTICAL or itemContent.railType = constants.RAIL_TYPES.SQUARE) and itemContent.railType <> "circular"
        placeHolder = getThemedPlaceholderUri("pkg:/images/placeholder-vertical.png")

        if verticalImageCache <> invalid and isValidString(itemContent.mediaId) and verticalImageCache.DoesExist(itemContent.mediaId)
            return {
                uri: verticalImageCache[itemContent.mediaId]
                placeHolder: placeHolder
            }
        end if

        if isValidString(itemContent.mediaId)
            getAdditionalImageResponse(itemContent.mediaId)
        end if

        return {
            uri: placeHolder
            placeHolder: placeHolder
        }
    end if

    return {
        uri: itemContent.image
        placeHolder: getThemedPlaceholderUri("pkg:/images/placeholder.png")
    }
end function

function getReleaseYearFromPubdate(pubdate as dynamic) as string
    if pubdate = invalid or pubdate <= 0 then return ""
    dateObj = CreateObject("roDateTime")
    dateObj.FromSeconds(pubdate)
    return dateObj.GetYear().ToStr()
end function

function formatPubdate(pubdate as dynamic) as string
    if pubdate = invalid or pubdate <= 0 then return ""
    dateObj = CreateObject("roDateTime")
    dateObj.FromSeconds(pubdate)
    dateObj.ToLocalTime()
    return dateObj.AsDateString("short-month-no-weekday")
end function

function getSeasonCountLabel(totalSeason as dynamic) as string
    if totalSeason = invalid then return ""
    seasonCount = Int(totalSeason)
    if seasonCount = 0 or seasonCount = 1
        return "1 Season"
    else
        return seasonCount.ToStr() + " Seasons"
    end if
end function

function buildMovieMetaDetailsArray(pageData as object) as object
    details = []
    if pageData = invalid then return details
    contentType = getContentType(pageData)
    if contentType = "movie" or contentType = ""
        if pageData.duration <> invalid and pageData.duration > 0
            duration = formatVideoDuration(pageData.duration, "h", "m", "s")
            if isValidString(duration) then details.push(duration)
        end if
    end if
    if type(m.global.custom) <> "roArray" and m.global.custom.isDisplayCreatedDate <> invalid and checkBool(m.global.custom.isDisplayCreatedDate)
        if pageData.pubdate <> invalid
            releaseYear = getReleaseYearFromPubdate(pageData.pubdate)
            if isValidString(releaseYear) then details.push(releaseYear)
        end if
    end if
    if pageData.rating <> invalid and isValidString(pageData.rating)
        details.push(pageData.rating)
    end if
    return details
end function

function buildSeriesMetaDetailsArray(pageData as object, seasonResponse as object, episodePubdate = invalid as dynamic) as object
    details = []
    if seasonResponse <> invalid and seasonResponse.season_count <> invalid
        details.push(getSeasonCountLabel(seasonResponse.season_count))
        if episodePubdate <> invalid
            releaseYear = getReleaseYearFromPubdate(episodePubdate)
            if isValidString(releaseYear) then details.push(releaseYear)
        end if
    end if
    if type(m.global.custom) <> "roArray" and m.global.custom.isDisplayCreatedDate <> invalid and checkBool(m.global.custom.isDisplayCreatedDate)
        if pageData <> invalid and pageData.pubdate <> invalid
            releaseYear = getReleaseYearFromPubdate(pageData.pubdate)
            if isValidString(releaseYear) then details.push(releaseYear)
        end if
    end if
    if pageData <> invalid and pageData.rating <> invalid and isValidString(pageData.rating)
        details.push(pageData.rating)
    end if
    return details
end function

function buildContentMetaDetailsArray(pageData as object) as object
    return buildMovieMetaDetailsArray(pageData)
end function

function formatContentMetaDetailsText(details as object) as string
    detailsArray = []
    if details = invalid then return ""
    for each detail in details
        if isValidString(detail) then detailsArray.push(detail)
    end for
    if detailsArray.count() = 0 then return ""
    return detailsArray.Join(" | ")
end function

function mergePodcastMenuItems(menuArray as object) as object
    mergedMenu = []
    if arrayHasItems(menuArray)
        for each menu in menuArray
            mergedMenu.Push(menu)
        end for
    end if
    customMenu = getCustomMenuConfig()
    if customMenu = invalid or not arrayHasItems(customMenu.menu) then return mergedMenu
    for each item in customMenu.menu
        if isValidAA(item) and LCase(item.type) = "podcast" and isValidString(item.url)
            insertIndex = mergedMenu.Count()
            if item.order <> invalid
                insertIndex = item.order - 1
                if insertIndex < 0 then insertIndex = 0
                if insertIndex > mergedMenu.Count() then insertIndex = mergedMenu.Count()
            end if
            result = []
            for i = 0 to mergedMenu.Count()
                if i = insertIndex then result.Push(item)
                if i < mergedMenu.Count() then result.Push(mergedMenu[i])
            end for
            mergedMenu = result
        end if
    end for
    return mergedMenu
end function

function getCustomMenuConfig() as object
    if m.global = invalid or m.global.custom = invalid then return invalid
    customMenu = m.global.custom.customMenu
    if customMenu = invalid then customMenu = m.global.custom.custom_menu
    if isValidString(customMenu)
        customMenu = ParseJson(customMenu)
    end if
    if isValidAA(customMenu) then return customMenu
    return invalid
end function

function parsePodcastCsv(csvText as string) as object
    rows = []
    if not isValidString(csvText) then return rows
    csvText = csvText.Replace(Chr(13) + Chr(10), Chr(10))
    csvText = csvText.Replace(Chr(13), Chr(10))
    lines = csvText.Split(Chr(10))
    isHeader = true
    for each line in lines
        line = line.Trim()
        if isValidString(line)
            if isHeader
                isHeader = false
            else
                parts = line.Split(",")
                if parts.Count() >= 2
                    rssUrl = parts[parts.Count() - 1].Trim()
                    title = ""
                    for i = 0 to parts.Count() - 2
                        if i > 0 then title = title + ","
                        title = title + parts[i]
                    end for
                    title = title.Trim()
                    if isValidString(title) and isValidUri(rssUrl)
                        rows.Push({
                            title: title
                            url: rssUrl
                        })
                    end if
                end if
            end if
        end if
    end for
    return rows
end function

function createPodcastContentNodes(rows as object) as object
    contentNode = CreateObject("roSGNode", "ContentNode")
    if not arrayHasItems(rows) then return contentNode
    for each row in rows
        childNode = contentNode.createChild("AssetDataModel")
        childNode.title = row.title
        if isValidString(row.url)
            childNode.link = row.url
        else if isValidString(row.link)
            childNode.link = row.link
        end if
        childNode.contentType = "podcast"
        childNode.media_type = "audio"
        childNode.showTitle = "true"
        childNode.setFields({
            shelfImageAspectRatio: "1:1"
            railType: "playlist"
        })
        if isValidString(row.image)
            childNode.image = row.image
        else
            childNode.image = "pkg:/images/placeholder.png"
        end if
        httpCode = 0
        if row.httpCode <> invalid then httpCode = row.httpCode
        childNode.addFields({ httpCode: httpCode })
    end for
    return contentNode
end function

function buildValidatedPodcastRow(item as object, xml as object, httpCode as integer) as object
    channel = getXmlChild(xml, "channel")
    title = item.title
    imageUrl = ""
    if channel <> invalid
        channelTitle = getXmlChildText(channel, "title")
        if isValidString(channelTitle) then title = channelTitle
        imageUrl = getPodcastImage(channel)
    end if
    if not isValidString(imageUrl) then imageUrl = "pkg:/images/placeholder.png"
    return {
        title: title
        url: item.url
        link: item.url
        image: imageUrl
        httpCode: httpCode
        contentType: "podcast"
        media_type: "audio"
        showTitle: "true"
    }
end function

function parsePodcastRss(xmlText as string) as object
    result = {
        title: ""
        image: ""
        episodes: []
    }
    if not isValidString(xmlText) then return result
    xml = CreateObject("roXMLElement")
    if not xml.Parse(xmlText) then return result
    channel = getXmlChild(xml, "channel")
    if channel = invalid then return result
    result.title = getXmlChildText(channel, "title")
    result.image = getPodcastImage(channel)
    result.description = getPodcastText(channel)
    result.author = getXmlChildText(channel, "author")
    result.genre = getPodcastCategories(channel)
    items = getXmlChildren(channel, "item")
    for each item in items
        title = getXmlChildText(item, "title")
        audioUrl = getXmlChildAttr(item, "enclosure", "url")
        imageUrl = getPodcastImage(item)
        if not isValidString(imageUrl) then imageUrl = result.image
        if not isValidString(imageUrl) then imageUrl = "pkg:/images/placeholder.png"
        duration = 0
        durText = getXmlChildText(item, "duration")
        if isValidString(durText) then duration = durText.ToInt()
        description = getPodcastText(item)
        if not isValidString(description) then description = result.description
        author = getXmlChildText(item, "author")
        if not isValidString(author) then author = result.author
        genre = getPodcastCategories(item)
        if not isValidString(genre) then genre = result.genre
        pubDateText = formatPodcastPubDate(getXmlChildText(item, "pubDate"))
        if isValidString(title) and isValidString(audioUrl)
            result.episodes.Push({
                title: title
                link: audioUrl
                image: imageUrl
                duration: duration
                description: description
                seriesTitle: result.title
                author: author
                genre: genre
                pubDateText: pubDateText
                contentType: "podcast_episode"
                media_type: "audio"
                isLive: false
                showTitle: "true"
                sources: [{
                    file: audioUrl
                    type: "audio/mpeg"
                }]
                images: [{
                    src: imageUrl
                    width: 1280
                    type: "image/jpeg"
                }]
            })
        end if
    end for
    return result
end function

function getXmlLocalName(node as object) as string
    name = LCase(node.GetName())
    colon = Instr(1, name, ":")
    if colon > 0 then return Mid(name, colon + 1)
    return name
end function

function getXmlChildren(parent as object, localName as string) as object
    matches = []
    if parent = invalid then return matches
    children = parent.GetChildElements()
    if children = invalid then return matches
    want = LCase(localName)
    for each child in children
        if getXmlLocalName(child) = want then matches.Push(child)
    end for
    return matches
end function

function getXmlChild(parent as object, localName as string) as object
    kids = getXmlChildren(parent, localName)
    if kids.Count() > 0 then return kids[0]
    return invalid
end function

function getXmlChildText(parent as object, localName as string) as string
    child = getXmlChild(parent, localName)
    if child = invalid then return ""
    return child.GetText()
end function

function getXmlChildAttr(parent as object, localName as string, attr as string) as string
    child = getXmlChild(parent, localName)
    if child = invalid then return ""
    attrs = child.GetAttributes()
    if attrs <> invalid and attrs.lookup(attr) <> invalid then return attrs[attr]
    return ""
end function

function getPodcastImage(parent as object) as string
    href = getXmlChildAttr(parent, "image", "href")
    if isValidString(href) then return href
    imageNode = getXmlChild(parent, "image")
    if imageNode = invalid then return ""
    return getXmlChildText(imageNode, "url")
end function

function getPodcastCategories(parent as object) as string
    categories = []
    collectPodcastCategories(parent, categories)
    return categories.Join(",")
end function

sub collectPodcastCategories(parent as object, categories as object)
    for each categoryNode in getXmlChildren(parent, "category")
        attrs = categoryNode.GetAttributes()
        if attrs <> invalid and attrs.lookup("text") <> invalid and isValidString(attrs["text"])
            categories.Push(attrs["text"])
        end if
        collectPodcastCategories(categoryNode, categories)
    end for
end sub

function formatPodcastPubDate(pubDateText as string) as string
    if not isValidString(pubDateText) then return ""
    parts = pubDateText.Trim().Split(" ")
    if parts.Count() > 0 and Right(parts[0], 1) = "," then parts.Shift()
    if parts.Count() < 3 then return ""
    return parts[1] + " " + parts[0] + ", " + parts[2]
end function

function getPodcastText(parent as object) as string
    text = getXmlDescendantText(getXmlChild(parent, "summary"))
    if isValidString(text) then return text
    text = getXmlDescendantText(getXmlChild(parent, "subtitle"))
    if isValidString(text) then return text
    text = getXmlDescendantText(getXmlChild(parent, "description"))
    if isValidString(text) then return text
    return getXmlDescendantText(getXmlChild(parent, "encoded"))
end function

function getXmlDescendantText(node as object) as string
    if node = invalid then return ""
    text = node.GetText()
    if isValidString(text) then return text.Trim()
    children = node.GetChildElements()
    if children = invalid then return ""
    combined = ""
    for each child in children
        combined = combined + getXmlDescendantText(child)
    end for
    return combined.Trim()
end function

sub init()
    m.backgroundMask = m.top.findNode("backgroundMask")
    m.background = m.top.findNode("background")
    m.borderTop = m.top.findNode("borderTop")
    m.borderBottom = m.top.findNode("borderBottom")
    m.borderLeft = m.top.findNode("borderLeft")
    m.borderRight = m.top.findNode("borderRight")
    m.label = m.top.findNode("buttonLabel")
    m.effectBackground = m.top.findNode("effectBackground")
    m.icon = m.top.findNode("icon")
    m.pressed = false
    m.top.focusable = true
    m.top.observeField("focusedChild", "updateButton")
    m.top.observeField("text", "updateButton")
    m.top.observeField("variant", "updateButton")
    m.top.observeField("enabled", "updateButton")
    if m.global <> invalid then m.global.observeField("localeCode", "onLocaleChanged")
    updateButton()
end sub

sub onLocaleChanged(event as object)
    updateButton()
end sub

sub updateButton()
    if m.background = invalid then return
    theme = GetTheme()
    w = m.top.width
    h = m.top.height

    variant = m.top.variant
    if type(variant) <> "String" then variant = "primary"
    enabled = m.top.enabled
    if type(enabled) <> "Boolean" then enabled = true
    focusEnabled = m.top.focusEnabled
    if type(focusEnabled) <> "Boolean" then focusEnabled = true

    canFocus = false
    if enabled
        if focusEnabled
            if variant <> "disabled" then canFocus = true
        end if
    end if
    m.top.focusable = canFocus

    ' ---- state ----
    state = "normal"
    if not enabled or variant = "disabled" then state = "disabled"
    if canFocus
        if m.top.hasFocus() then state = "focused"
    end if
    if m.pressed and enabled then state = "pressed"

    ' ---- style: theme, then per-instance overrides, then focus overrides ----
    style = GetButtonTheme(theme, variant, state)
    if m.top.backgroundColor <> -1 then style.background = m.top.backgroundColor
    if m.top.textColor <> -1 then style.text = m.top.textColor
    if m.top.borderColor <> -1 then style.border = m.top.borderColor
    if m.top.borderWidth > 0 then style.borderWidth = m.top.borderWidth

    radius = m.top.cornerRadius
    if radius < 0 then radius = theme.radii.md

    colors = m.top.gradientColors
    gradientStyle = m.top.gradientStyle
    gradientAngle = m.top.gradientAngle
    gradientStops = m.top.gradientStops

    if state = "focused"
        if m.top.focusedBackgroundColor <> -1 then style.background = m.top.focusedBackgroundColor
        if m.top.focusedTextColor <> -1 then style.text = m.top.focusedTextColor
        if m.top.focusedBorderColor <> -1 then style.border = m.top.focusedBorderColor
        if m.top.focusedBorderWidth >= 0 then style.borderWidth = m.top.focusedBorderWidth
        if m.top.focusedCornerRadius >= 0 then radius = m.top.focusedCornerRadius
        focusedColors = m.top.focusedGradientColors
        if focusedColors <> invalid
            if focusedColors.count() >= 2 then colors = focusedColors
        end if
    end if

    ' ---- gradient preset (only when no colors were supplied) ----
    maxRadius = h / 2
    if radius > maxRadius then radius = maxRadius
    needsPreset = colors = invalid
    if not needsPreset then needsPreset = colors.count() < 2
    if needsPreset
        presetName = m.top.gradientPreset
        if presetName <> ""
            if theme.gradients <> invalid
                preset = theme.gradients[presetName]
                if preset <> invalid
                    colors = preset.colors
                    gradientStyle = preset.style
                    gradientAngle = preset.angle
                    gradientStops = preset.stops
                end if
            end if
        end if
    end if

    hasGradient = false
    if colors <> invalid
        if colors.count() >= 2 then hasGradient = true
    end if
    if gradientStyle = invalid then gradientStyle = "none"
    if gradientAngle = invalid then gradientAngle = 0
    ' Colors supplied but style left at "none" -> assume linear
    if hasGradient
        if gradientStyle = "none" or gradientStyle = "" then gradientStyle = "linear"
    end if

    bgColor = resolveColor(style.background)
    textCol = resolveColor(style.text)
    borderCol = resolveColor(style.border)
    borderW = style.borderWidth
    if borderW = invalid then borderW = 0

    ' ---- background ----
    m.effectBackground.width = w
    m.effectBackground.height = h
    ' White base so the gradient isn't multiplied by a tint
    if hasGradient then m.effectBackground.color = &hFFFFFFFF else m.effectBackground.color = bgColor

    effectApplied = ApplyNodeEffect(m.effectBackground, radius, borderW, borderCol, colors, gradientStops, gradientStyle, gradientAngle)
    m.effectBackground.visible = effectApplied
    m.backgroundMask.visible = not effectApplied

    if not effectApplied
        ' OS < 16 fallback: masked poster, solid color (first gradient stop if any)
        fallbackColor = bgColor
        if hasGradient then fallbackColor = resolveColor(colors[0])
        layoutFallback(w, h, fallbackColor, borderCol, borderW)
    end if

    ' ---- label + optional icon ----
    textSize = m.top.fontSize
    if textSize <= 0 then textSize = theme.typography.sizes.button
    m.label.font = CreateThemeFont(theme.typography.fonts.medium, textSize)
    m.label.color = textCol
    buttonText = m.top.text
    if buttonText = invalid then buttonText = ""
    if buttonText.Trim() = ""
        buttonText = getButtonText(m.top.mediaType, m.top.contentType)
    end if
    m.label.text = buttonText

    iconW = m.top.iconWidth
    iconH = m.top.iconHeight
    gap = m.top.iconGap
    hasIcon = false
    if m.top.iconUri <> ""
        if iconW > 0
            if iconH > 0 then hasIcon = true
        end if
    end if

    iconSpace = 0
    if hasIcon then iconSpace = iconW + gap
     m.label.width = 0
    m.label.height = 0
    textWidth = m.label.boundingRect().width + 1
    maxText = w - 32 - iconSpace
    if maxText < 0 then maxText = 0
    if textWidth > maxText then textWidth = maxText

    startX = (w - (textWidth + iconSpace)) / 2
    if startX < 0 then startX = 0

    labelX = startX
    if hasIcon
        iconX = startX
        if LCase(m.top.iconPosition) = "right"
            iconX = startX + textWidth + gap
        else
            labelX = startX + iconSpace
        end if
        m.icon.uri = m.top.iconUri
        m.icon.width = iconW
        m.icon.height = iconH
        m.icon.translation = [iconX, (h - iconH) / 2]
        if m.top.tintIcon then m.icon.blendColor = textCol else m.icon.blendColor = &hFFFFFFFF
        m.icon.visible = true
    else
        m.icon.visible = false
    end if

    m.label.width = textWidth
    m.label.height = h
    m.label.translation = [labelX, 0]
    m.label.visible = true
end sub

sub layoutFallback(w as float, h as float, bg as integer, border as integer, borderW as float)
    m.backgroundMask.width = w
    m.backgroundMask.height = h
    m.backgroundMask.maskSize = [w, h]
    m.background.width = w
    m.background.height = h
    m.background.blendColor = bg

    edge = borderW
    if edge < 1 then edge = 1
    if edge > h / 2 then edge = h / 2
    m.borderTop.width = w : m.borderTop.height = edge
    m.borderBottom.width = w : m.borderBottom.height = edge
    m.borderBottom.translation = [0, h - edge]
    m.borderLeft.width = edge : m.borderLeft.height = h
    m.borderRight.width = edge : m.borderRight.height = h
    m.borderRight.translation = [w - edge, 0]
    opacity = 1
    if borderW <= 0 then opacity = 0
    for each b in [m.borderTop, m.borderBottom, m.borderLeft, m.borderRight]
        b.color = border
        b.opacity = opacity
    end for
end sub

function resolveColor(value as dynamic) as integer
    t = LCase(type(value))
    if t = "string" or t = "rostring" then return ThemeColor(value)
    if value = invalid then return &hFFFFFFFF
    return value
end function

function updateFocus() as boolean
    updateButton()
    return true
end function

function onKeyEvent(key as string, press as boolean) as boolean
    enabled = m.top.enabled
    if enabled = invalid then enabled = true
    variant = m.top.variant
    if type(variant) <> "String" then variant = "primary"
    if not enabled then return false
    if variant = "disabled" then return false
    if key = "OK" or key = "Select"
        if press
            m.pressed = true
            updateButton()
        else
            m.pressed = false
            updateButton()
            m.top.activated = { text: m.label.text, variant: variant }
        end if
        return true
    end if
    return false
end function

function getButtonText(mediaType as dynamic, contentType as dynamic) as string
    normalizedMediaType = normalizeButtonType(mediaType)
    normalizedContentType = normalizeButtonType(contentType)
    localizationKey = "WATCH_NOW"
    mappings = [
        { mediaType: "audio", contentType: "*", key: "LISTEN_NOW" }
    ]
    for each mapping in mappings
        mediaMatches = mapping.mediaType = "*" or mapping.mediaType = normalizedMediaType
        contentMatches = mapping.contentType = "*" or mapping.contentType = normalizedContentType
        if mediaMatches and contentMatches
            localizationKey = mapping.key
            exit for
        end if
    end for
    strings = m.top.localizationStrings
    if strings <> invalid then return RokuCore.GetLocalizedString({ strings: strings }, [localizationKey], "")
    return RokuCore.GetLocalizedString(GetGlobalAA(), [localizationKey], "")
end function

function normalizeButtonType(value as dynamic) as string
    if value = invalid then return ""
    valueType = LCase(type(value))
    if valueType <> "string" and valueType <> "rostring" then return ""
    return LCase(value.Trim())
end function

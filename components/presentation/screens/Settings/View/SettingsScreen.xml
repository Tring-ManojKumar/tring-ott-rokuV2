<?xml version="1.0" encoding="UTF-8" ?>
<component name="SettingsScreen" extends="Group">
    <interface>
        <field id="navigationParams" type="assocarray" onChange="onNavigationParamsChanged" />
        <field id="frameworkSupportsInitialFocus" type="boolean" value="true" />
        <field id="frameworkLifecycleEvent" type="string" value="" />
        <field id="frameworkCreated" type="boolean" value="false" alwaysNotify="true" />
        <field id="frameworkInitialized" type="boolean" value="false" alwaysNotify="true" />
        <field id="frameworkPresented" type="boolean" value="false" alwaysNotify="true" />
        <field id="frameworkSuspended" type="boolean" value="false" alwaysNotify="true" />
        <field id="frameworkResumed" type="boolean" value="false" alwaysNotify="true" />
        <field id="frameworkExited" type="boolean" value="false" alwaysNotify="true" />
        <field id="frameworkDestroyed" type="boolean" value="false" alwaysNotify="true" />
        <field id="frameworkCleanupRequested" type="boolean" value="false" alwaysNotify="true" onChange="onFrameworkCleanupRequested" />
        <function name="setInitialFocus" />
    </interface>
    <script type="text/brightscript" uri="SettingsScreen.bs" />
    <children>
        <Rectangle id="background" width="1920" height="1080" color="0x101820FF" />
        <AppLabel id="heading" translation="[100, 90]" width="900" height="70" text="Settings" variant="heading" />
        <LabelList id="settingsList" translation="[100, 190]" itemSize="[900, 72]" itemSpacing="[0, 8]" />
        <Label id="details" translation="[1060, 220]" width="760" height="600" wrap="true" color="0xFFFFFFFF" font="font:MediumSystemFont" text="Select an item for details." />
        <Label id="backHint" translation="[100, 950]" width="800" height="50" text="Press Back to return" color="0xB3B3B3FF" font="font:SmallSystemFont" />
        <SettingsViewModel id="viewModel" />
    </children>
</component>

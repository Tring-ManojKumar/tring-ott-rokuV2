function updateUserPenalization(response)
    history = []
    favorites = []
    if response <> invalid and response.responseData <> invalid
        profile = response.responseData
        if profile.externalData <> invalid and arrayHasItems(profile.externalData.history)
            history = profile.externalData.history
        end if
        if profile.externalData <> invalid and arrayHasItems(profile.externalData.favorites)
            favorites = profile.externalData.favorites
        end if
    end if
    m.global.Update({
        favorites: favorites,
        history: history,
        isUserAuthenticated: true
    }, true)
end function

function getProfileData(response) as object
    profileInfo = {}
    name = ""
    email = ""
    id = ""
    if response <> invalid and response.responseData <> invalid
        profile = response.responseData
        fullName = profile?.firstname + " " + profile?.lastname
        name = fullName
        email = profile?.email
        id = profile?.id
        updateUserPenalization(response)
    else if isCustomAPI() and response <> invalid
        if response?.profile <> invalid
            profile = response?.profile?.profile
            fullName = profile?.firstname + " " + profile?.lastname
            name = fullName
            if profile?.uuid <> invalid
                id = profile?.uuid
            end if
        end if
        user = response?.user
        if user <> invalid and user.email <> invalid
            email = user.email

            if user.username <> invalid
                id = user.username
            end if
        end if
    else
        if response?.full_name <> invalid
            name = response?.full_name
        end if
        if response?.email <> invalid
            email = response?.email
        end if

        if response?.uuid <> invalid
            id = response?.uuid
        end if
    end if
    profileInfo = {
        "name": name,
        "email": email,
        "id": id
    }
    m.global.Update({
        userInfo: profileInfo
        isUserAuthenticated: true
    }, true)
    return profileInfo
end function

sub updateFavourites(favorites = [])
    m.global.Update({
        favorites: favorites,
    }, true)
end sub

function getFavourites() as object
    if arrayHasItems(m.global.favorites)
        return m.global.favorites
    end if
    return []
end function

sub deleteFavourites(contentID as string)
    if isValidString(contentID)
        favorites = getFavourites()
        deleteIndex = -1
        for i = 0 to favorites.count() - 1
            item = favorites[i]
            if item.mediaid = contentId
                deleteIndex = i
            end if
        end for
        if deleteIndex > -1
            favorites.Delete(deleteIndex)
        end if
        m.global.Update({
            favorites: favorites
        }, true)
    end if
end sub

function getFavouritesById(contentId as string) as boolean
    result = false
    if arrayHasItems(m.global.favorites)
        favorites = m.global.favorites
        for each item in favorites
            if item.mediaid = contentId
                result = true
                return result
            end if
        end for
    end if
    return result
end function

sub updateHistory(history = [])

function getFontScalePresets() as object
    ' Small, Medium (Default), Large, Extra Large
    return [0.85, 1.0, 1.25, 1.50]
end function

function getFontScaleDefaultIndex() as integer
    return 1
end function

function getFontScaleOptionLabels() as object
    fallback = ["Small", "Medium (Default)", "Large", "Extra Large"]
    strings = m.global.strings
    if strings = invalid or strings.SETTINGS_SCREEN = invalid then return fallback
    settings = strings.SETTINGS_SCREEN
    if not isValidString(settings.TEXT_SIZE_SMALL) then return fallback
    if not isValidString(settings.TEXT_SIZE_MEDIUM_DEFAULT) then return fallback
    if not isValidString(settings.TEXT_SIZE_LARGE) then return fallback
    if not isValidString(settings.TEXT_SIZE_XLARGE) then return fallback
    return [
        settings.TEXT_SIZE_SMALL
        settings.TEXT_SIZE_MEDIUM_DEFAULT
        settings.TEXT_SIZE_LARGE
        settings.TEXT_SIZE_XLARGE
    ]
end function

function getFontScaleValueLabel(scale as float) as string
    index = getFontScaleIndex(scale)
    fallback = ["Small", "Medium", "Large", "Extra Large"]
    strings = m.global.strings
    if strings = invalid or strings.SETTINGS_SCREEN = invalid
        if index >= 0 and index < fallback.Count() then return fallback[index]
        return "Medium"
    end if
    settings = strings.SETTINGS_SCREEN
    labels = [
        settings.TEXT_SIZE_SMALL
        settings.TEXT_SIZE_MEDIUM
        settings.TEXT_SIZE_LARGE
        settings.TEXT_SIZE_XLARGE
    ]
    if index >= 0 and index < labels.Count() and isValidString(labels[index]) then return labels[index]
    if index >= 0 and index < fallback.Count() then return fallback[index]
    return "Medium"
end function

function shouldApplyUserFontScale() as boolean
    if m.global = invalid or not isValidString(m.global.currentScreen) then return false
    screenId = m.global.currentScreen
    if screenId <> "HomeScreen" and screenId <> "LandingGridScreen" and screenId <> "ContentDetailScreen" and screenId <> "MoreInfoScreen" and screenId <> "SearchScreen" and screenId <> "SignInScreen" and screenId <> "SignUpScreen" and screenId <> "ProfileScreen" and screenId <> "LoginDeciderScreen" and screenId <> "OnboardingScreen" then return false
    if m.top <> invalid
        nodeId = m.top.id
        if nodeId = "Menu" or nodeId = "MenuItem" then return false
    end if
    return true
end function

function scaleTextFontSize(baseSize as integer) as integer
    if not shouldApplyUserFontScale() then return baseSize
    scale = m.global.fontScale
    if scale = invalid or scale <= 0 then scale = 1.0
    return Int(baseSize * scale + 0.5)
end function

function isValidFontScale(scale as float) as boolean
    presets = getFontScalePresets()
    for each preset in presets
        if preset = scale then return true
    end for
    return false
end function

function getNearestFontScale(scale as float) as float
    presets = getFontScalePresets()
    nearest = presets[getFontScaleDefaultIndex()]
    minDiff = Abs(scale - nearest)
    for each preset in presets
        diff = Abs(scale - preset)
        if diff < minDiff
            minDiff = diff
            nearest = preset
        end if
    end for
    return nearest
end function

function getDefaultFontScale() as float
    stored = readFromRegistry("fontScale")
    scale = 1.0
    if isValidString(stored)
        scale = stored.ToFloat()
    end if
    return getNearestFontScale(scale)
end function

function getFontScaleIndex(scale as float) as integer
    nearest = getNearestFontScale(scale)
    presets = getFontScalePresets()
    for i = 0 to presets.Count() - 1
        if presets[i] = nearest then return i
    end for
    return getFontScaleDefaultIndex()
end function

sub setGlobalFontScale(scale as float)
    if not isValidFontScale(scale) then scale = 1.0
    m.global.fontScale = scale
    writeToRegistry("fontScale", scale.ToStr())
end sub

function getDefaultAutoPlayState() as string
    configID = getAppConfigId()
    autoplayFlagKay = getHashValue("autoplay" + configID)
    autoplayFlag = readFromRegistry(autoplayFlagKay)
    if not isValidString(autoplayFlag)
        defaultValue = ""
        if m.global.featureFlags.settings <> invalid and m.global.featureFlags.settings.autoplay_default_value <> invalid
            defaultValue = m.global.featureFlags.settings.autoplay_default_value
        end if
        if LCase(defaultValue) = "on"
            autoplayFlag = "true"
        else
            autoplayFlag = "false"
        end if
        writeToRegistry(autoplayFlagKay, autoplayFlag)
    end if
    return autoplayFlag
end function

' Platform wins when both layers define the key; otherwise use global; otherwise false.
function resolveAutoPlayFlag() as boolean
    platform = m.global.platforms
    if platform <> invalid
        if hasFlagValue(platform.isAutoPlayEnabled) then return checkBool(platform.isAutoPlayEnabled)
        if hasFlagValue(platform.is_autoplay_enabled) then return checkBool(platform.is_autoplay_enabled)
    end if
    settings = invalid
    if m.global.featureFlags <> invalid then settings = m.global.featureFlags.settings
    if settings <> invalid and hasFlagValue(settings.is_autoplay_enabled)
        return checkBool(settings.is_autoplay_enabled)
    end if
    return false
end function

function hasFlagValue(value as dynamic) as boolean
    return isValidBool(value) or (isValidString(value) and (LCase(value) = "true" or LCase(value) = "false"))
end function

function isAutoPlayVisible() as boolean
    return resolveAutoPlayFlag()
end function

function isAutoPlayEnabled() as boolean
    return resolveAutoPlayFlag() and getDefaultAutoPlayState() = "true"
end function

function isShowProfileIcon() as boolean
    return m.global.featureFlags <> invalid and isValidBool(m.global.featureFlags.is_profile_enabled) and m.global.featureFlags.is_profile_enabled
end function

function isSettingScreenEnabled() as boolean

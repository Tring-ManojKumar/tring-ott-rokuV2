end sub

sub getCustomerId(data as object) as integer
    id = 0
    if(data <> invalid and data.customerId <> invalid)
        id = data.customerId
    end if
    return id
end sub

sub getAccessToken(data as object) as string
    token = ""
    if(data <> invalid and isValidString(data.accessToken))
        token = data.accessToken
    else if(data <> invalid and isValidString(data.access_token))
        token = data.access_token
    else if(data <> invalid and isValidString(data.AccessToken))
        token = data.AccessToken
    else if(data <> invalid and isValidString(data.jwt))
        token = data.jwt
    end if
    return token
end sub

sub getRefreshToken(data as object) as string
    token = ""
    if(data <> invalid and isValidString(data.refreshToken))
        token = data.refreshToken
    else if(data <> invalid and isValidString(data.RefreshToken))
        token = data.RefreshToken
    else if(data <> invalid and isValidString(data.refresh_token))
        token = data.refresh_token
    end if
    return token
end sub

function getUserSubscription() as object
    if m.global.subscription <> invalid
        return m.global.subscription
    end if
    return {}
end function


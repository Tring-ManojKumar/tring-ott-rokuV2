<?xml version="1.0" encoding="UTF-8" ?>
<component name="CredentialSignupTask" extends="Task">
    <interface>
        <field id="firstName" type="string" />
        <field id="lastName" type="string" />
        <field id="email" type="string" />
        <field id="password" type="string" />
        <field id="passwordConfirmation" type="string" />
        <field id="requestState" type="string" value="IDLE" alwaysNotify="true" />
        <field id="session" type="assocarray" />
        <field id="errorMessage" type="string" value="" />
    </interface>
    <script type="text/brightscript" uri="CredentialSignupTask.bs" />
</component>

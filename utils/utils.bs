end function

function getCleengMaxNoOfFav() as integer
    if m.global.firebaseCleeng.max_no_of_fav <> invalid
        if isValidString(m.global.firebaseCleeng.max_no_of_fav)
            return m.global.firebaseCleeng.max_no_of_fav.toInt()
        else
            return m.global.firebaseCleeng.max_no_of_fav
        end if
    end if

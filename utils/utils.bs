sub addUserTokenToRegistry2(userDetails, idToken = "")
    currentDate = CreateObject("roDateTime").AsSeconds()
    customerId = ""
    if userDetails <> invalid and userDetails.customerId <> invalid
        customerId = userDetails.customerId
    end if
    if isValidString(userDetails.RefreshToken)
        userReg = {
            access_token: userDetails.AccessToken
            refresh_token: userDetails.RefreshToken
            expires: userDetails.ExpiresIn + currentDate,
            idToken: idToken,
            customerId: customerId
        }
    else
        userInfo = readFromRegistry("user_token")
        userInfo = ParseJson(userInfo)
        userReg = {
            access_token: userDetails.AccessToken
            refresh_token: userInfo.refresh_token
            expires: userDetails.ExpiresIn + currentDate,
            idToken: idToken,
            customerId: customerId
        }
    end if
    writeToRegistry("user_token", FormatJson(userReg))
end sub

sub storeRefreshToken(response)
    currentDate = CreateObject("roDateTime").AsSeconds()
    userInfo = readFromRegistry("user_token")
    userInfo = ParseJson(userInfo)
    access_token = userInfo.access_token
    refresh_token = userInfo.refresh_token
    expires = userInfo.expires
    idToken = userInfo.idToken
    customerId = userInfo.customerId
    if response.idtoken <> invalid and isValidString(response.idtoken)
        idtoken = response.idtoken
    end if

    if response.expires <> invalid
        expires = expires + response.expires
    else
        expires = expires + 900
    end if

    if response.access_token <> invalid and isValidString(response.access_token)
        access_token = response.access_token
    end if

    if response.refresh_token <> invalid and isValidString(response.refresh_token)
        refresh_token = response.refresh_token
    end if
    if response.responseData <> invalid
        data = response.responseData
        if data.jwt <> invalid and isValidString(data.jwt)
            access_token = data.jwt
        end if

        if data.refreshToken <> invalid and isValidString(data.refreshToken)
            refresh_token = data.refreshToken
        end if
    end if

    userReg = {
        access_token: access_token
        refresh_token: refresh_token
        expires: expires,
        idToken: idToken,
        customerId: customerId
    }
    m.global.Update({
        user_access_token: access_token
        refresh_token: refresh_token
        idtoken: idtoken,
        expires: expires,
        customerId: customerId,
        isUserAuthenticated: true
    }, true)
    writeToRegistry("user_token", FormatJson(userReg))
end sub

sub sendAnalyticsEvent(data as object)
    if isAnalyticsEventEnabled()
        if m.top.pageAction = invalid
            m.top.getScene().callFunc("sendAnalyticsEventData", data)
        else
            m.top.pageAction = {
                type: "sendAnalyticsEvent"
                data: data
            }
        end if    
    end if
end sub

sub sendGAScreenViewEvent(event, params)

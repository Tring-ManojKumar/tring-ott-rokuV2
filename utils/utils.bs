    globalAuthEnabled = m.global.authentication <> invalid and isValidBool(m.global.authentication.is_authentication_enabled) and m.global.authentication.is_authentication_enabled
    if m.global.platforms <> invalid and m.global.platforms.is_authentication_enabled <> invalid
        rokuAuthEnabled = m.global.platforms <> invalid and isValidBool(m.global.platforms.is_authentication_enabled) and m.global.platforms.is_authentication_enabled
        return rokuAuthEnabled
    end if
    return globalAuthEnabled
end function


namespace Domain
    class GetLandingSectionsUseCase
        private repository as object

        function new(repository as object)
            m.repository = repository
        end function

        function execute(appConfiguration as dynamic, isAuthenticated as boolean) as object
            if m.repository = invalid then return invalid
            return m.repository.getHomeSections(appConfiguration, isAuthenticated)
        end function
    end class
end namespace

        <AppButton id="signInButton" translation="[440, 936]" width="314" height="70" text="Sign In" variant="primary" />
        <AppButton id="signUpButton" translation="[774, 936]" width="314" height="70" text="Sign Up" variant="secondary" />
        <AppButton id="guestButton" translation="[1108, 936]" width="314" height="70" text="Continue As Guest" variant="secondary" />
    </children>
    <script type="text/brightscript" uri="LoginDeciderScreen.bs" />
</component>

import "pkg:/domain/usecases/ResolveOnboardingUseCase.bs"

namespace tests.domain
    class FakeStartupStateRepositoryForOnboarding extends Domain.StartupStateRepository
        public completed as boolean
        function hasCompletedOnboarding(configId as string) as boolean
            return m.completed
        end function
        function markOnboardingCompleted(configId as string) as boolean
            m.completed = true
            return true
        end function
        function readUserSession() as dynamic
            return invalid
        end function
        function saveUserSession(response as dynamic) as boolean
            return false
        end function
        function clearUserSession() as boolean
            return true
        end function
    end class

    @suite("Market App Config onboarding decision")
    class ResolveOnboardingUseCaseTests extends rooibos.BaseTestSuite
        @describe("Feature and Roku platform precedence")
        @it("uses the Roku platform override and exposes Firebase Roku slides")
        function platformOverrideAndSlides()
            repository = new FakeStartupStateRepositoryForOnboarding()
            useCase = new Domain.ResolveOnboardingUseCase(repository)
            resolved = {
                configId: "market-config"
                featureFlags: { is_onboarding_screen_enabled: true }
                platforms: { is_onboarding_screen_enabled: false }
                rokuConfig: { onBoarding: [{ page_title: "Welcome" }] }
            }
            decision = useCase.execute(resolved)
            m.assertFalse(decision.enabled)
            m.assertFalse(decision.shouldShow)
            m.assertEqual(decision.slides.Count(), 1)
        end function

        @describe("Market App Config completion")
        @it("shows onboarding once per configured App Config ID")
        function configSpecificCompletion()
            repository = new FakeStartupStateRepositoryForOnboarding()
            useCase = new Domain.ResolveOnboardingUseCase(repository)
            resolved = {
                configId: "market-a"
                featureFlags: { is_onboarding_screen_enabled: true }
                platforms: {}
                rokuConfig: { onBoarding: [{ page_title: "Welcome" }] }
            }
            first = useCase.execute(resolved)
            m.assertTrue(first.shouldShow)
            repository.completed = true
            nextLaunch = useCase.execute(resolved)
            m.assertTrue(nextLaunch.completed)
            m.assertFalse(nextLaunch.shouldShow)
            repository.completed = false
            otherMarket = useCase.execute({
                configId: "market-b"
                featureFlags: { is_onboarding_screen_enabled: true }
                platforms: {}
                rokuConfig: { onBoarding: [{ page_title: "Welcome" }] }
            })
            m.assertTrue(otherMarket.shouldShow)
        end function

        @describe("V1 Tring Play fallback")
        @it("uses the packaged slides when Firebase does not provide Roku slides")
        function tringPlayFallbackSlides()
            repository = new FakeStartupStateRepositoryForOnboarding()
            useCase = new Domain.ResolveOnboardingUseCase(repository)
            decision = useCase.execute({
                configId: "ffuxvbfv"
                featureFlags: { is_onboarding_screen_enabled: true }
                platforms: {}
                rokuConfig: {}
            })
            m.assertTrue(decision.shouldShow)
            m.assertEqual(decision.slides.Count(), 3)
            m.assertEqual(decision.slides[0].image_uri, "pkg:/assets/images/onboarding-page-1.png")
            m.assertEqual(decision.slides[0].page_title, "Instant access without waiting")
            m.assertEqual(decision.slides[1].page_title, "Live TV channel streaming")
            m.assertEqual(decision.slides[2].page_title, "Ultra HD video quality")
        end function

        @describe("KSL market flags fallback")
        @it("uses the three V1 KSL landing slides and skips completed onboarding")
        function kslFlagsFallbackAndCompletion()
            repository = new FakeStartupStateRepositoryForOnboarding()
            useCase = new Domain.ResolveOnboardingUseCase(repository)
            flags = {
                images: {
                    onBording1: "https://example.test/landing1.png"
                    onBording2: "https://example.test/landing2.png"
                    onBording3: "https://example.test/landing3.png"
                }
            }
            resolved = {
                configId: "jbeorebm"
                featureFlags: { is_onboarding_screen_enabled: true }
                platforms: {}
                rokuConfig: {}
            }

            firstLaunch = useCase.execute(resolved, flags)
            m.assertTrue(firstLaunch.shouldShow)
            m.assertEqual(firstLaunch.slides.Count(), 3)
            m.assertEqual(firstLaunch.slides[0].image_uri, flags.images.onBording1)
            m.assertEqual(firstLaunch.slides[2].localizationKey, "PAGE_3")

            repository.completed = true
            subsequentLaunch = useCase.execute(resolved, flags)
            m.assertTrue(subsequentLaunch.completed)
            m.assertFalse(subsequentLaunch.shouldShow)
        end function

        @describe("Onboarding media selection")
        @it("prefers the API onboarding video over the asset video")
        function apiVideoHasPriority()
            useCase = new Domain.ResolveOnboardingUseCase(new FakeStartupStateRepositoryForOnboarding())
            decision = useCase.execute({
                configId: "market-config"
                featureFlags: { is_onboarding_screen_enabled: true }
                platforms: {}
                rokuConfig: { onboarding_video: "https://cdn.example.test/onboarding.mp4" }
            }, {
                assets: { splash_video: "pkg:/assets/splash.mp4" }
                onboardingImage: ["pkg:/assets/onboarding.png"]
            })

            m.assertTrue(decision.shouldShow)
            m.assertEqual(decision.media.type, "video")
            m.assertEqual(decision.media.uri, "https://cdn.example.test/onboarding.mp4")
            m.assertEqual(decision.media.fallbackImage, "pkg:/assets/onboarding.png")
        end function

        @it("uses the asset splash video when the API video is empty")
        function assetVideoFallback()
            useCase = new Domain.ResolveOnboardingUseCase(new FakeStartupStateRepositoryForOnboarding())
            decision = useCase.execute({
                configId: "market-config"
                featureFlags: { is_onboarding_screen_enabled: true }
                platforms: {}
                rokuConfig: { onboarding_video: " " }
            }, {
                assets: { splash_video: "pkg:/assets/splash.mp4" }
                onboardingImage: ["pkg:/assets/onboarding.png"]
            })

            m.assertEqual(decision.media.type, "video")
            m.assertEqual(decision.media.uri, "pkg:/assets/splash.mp4")
            m.assertEqual(decision.media.fallbackImage, "pkg:/assets/onboarding.png")
        end function

        @it("uses the first onboarding image when both video sources are empty")
        function onboardingImageFallback()
            useCase = new Domain.ResolveOnboardingUseCase(new FakeStartupStateRepositoryForOnboarding())
            decision = useCase.execute({
                configId: "market-config"
                featureFlags: { is_onboarding_screen_enabled: true }
                platforms: {}
                rokuConfig: { onboarding_video: "" }
            }, {
                assets: { splash_video: "" }
                onboardingImage: ["https://cdn.example.test/onboarding.png", "https://cdn.example.test/other.png"]
            })

            m.assertEqual(decision.media.type, "image")
            m.assertEqual(decision.media.uri, "https://cdn.example.test/onboarding.png")
        end function
    end class
end namespace

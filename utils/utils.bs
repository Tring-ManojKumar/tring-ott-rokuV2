function getAdDeliveryMethod() as String
    if m.global.platforms.feature_flags <> invalid and m.global.platforms.feature_flags.ad_settings <> invalid
        if m.global.platforms.feature_flags.ad_settings.ad_delivery_method <> invalid and m.global.platforms.feature_flags.ad_settings.ad_delivery_method <> ""
                m.ad_delivery_method = m.global.platforms.feature_flags.ad_settings.ad_delivery_method
        end if
    end if
    if m.global.featureFlags.ad_settings <> invalid and m.global.featureFlags.ad_settings.ad_delivery_method <> invalid and  m.global.featureFlags.ad_settings.ad_delivery_method <>""
        ' Getting ad delivery method from global feature flag
        m.ad_delivery_method = m.global.featureFlags.ad_settings.ad_delivery_method
    end if
    if  m.ad_delivery_method <> invalid 
        return  m.ad_delivery_method
    else
        return ""
    end if
end function


function getAlgoliaSearchConfig() as object
    if m.global.featureFlags <> invalid and m.global.featureFlags.algolia_settings <> invalid
        return m.global.featureFlags.algolia_settings
    end if
    if m.global.platforms <> invalid and m.global.platforms.algolia_search <> invalid
        return m.global.platforms.algolia_search
    end if
    return invalid
end function

function isAlgoliaAbsoluteUrl(url as dynamic) as boolean
    if not isValidString(url) then return false
    lowerUrl = LCase(url)
    return Left(lowerUrl, 4) = "http"
end function

function getAlgoliaHitProductId(hit as object) as string
    if hit = invalid then return ""
    if hit.output <> invalid and hit.output.id <> invalid
        return hit.output.id.ToStr()
    end if
    if hit.id <> invalid then return hit.id.ToStr()
    return ""
end function

function getAlgoliaHitOutputDate(hit as object) as string
    if hit = invalid then return ""
    output = hit.output
    if output = invalid then return ""
    dateValue = output.date
    if dateValue = invalid then return ""
    return dateValue.ToStr().Trim()
end function

function getAlgoliaHitsFromResponseString(responseString as string) as object
    if not isValidString(responseString) then return []
    response = ParseJson(responseString)
    if response = invalid or response.hits = invalid then return []
    return response.hits
end function

function getAlgoliaPaginationFromResponseString(responseString as string) as object
    page = 0
    nbPages = 1
    if isValidString(responseString)
        response = ParseJson(responseString)
        if response <> invalid
            if response.page <> invalid then page = response.page
            if response.nbPages <> invalid then nbPages = response.nbPages
        end if
    end if
    return { page: page, nbPages: nbPages }
end function

function resolveAlgoliaHitImage(hit as object) as string
    if hit = invalid then return ""

    if hit.output <> invalid and isValidString(hit.output.image)
        return hit.output.image
    end if

    if isValidString(hit.link_main_img) and isAlgoliaAbsoluteUrl(hit.link_main_img)
        return hit.link_main_img
    end if

    if isValidString(hit.image_url)
        if isAlgoliaAbsoluteUrl(hit.image_url) then return hit.image_url

        config = getAlgoliaSearchConfig()
        if config <> invalid and isValidString(config.imageBaseUrl)
            baseUrl = config.imageBaseUrl
            if Right(baseUrl, 1) = "/" and Left(hit.image_url, 1) = "/"
                return Left(baseUrl, baseUrl.Len() - 1) + hit.image_url
            else if Right(baseUrl, 1) <> "/" and Left(hit.image_url, 1) = "/"
                return baseUrl + hit.image_url
            else
                return baseUrl + hit.image_url
            end if
        end if

        return hit.image_url
    end if

    if isValidString(hit.link_main_img) then return hit.link_main_img

    return ""
end function


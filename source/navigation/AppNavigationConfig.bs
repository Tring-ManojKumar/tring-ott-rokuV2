import "pkg:/source/navigation/AppRoutes.bs"

' Application-owned mapping from stable route identifiers to SceneGraph component types.
' Core remains responsible for validating and resolving this map.
namespace AppNavigationConfig
    function GetConfig() as object
        routes = {}
        routes[AppRoutes.HOME] = "HomeScreen"
        routes[AppRoutes.ONBOARDING] = "OnboardingScreen"
        routes[AppRoutes.AUTH_CHECK] = "AuthCheckScreen"
        routes[AppRoutes.SETTINGS] = "SettingsScreen"
        routes[AppRoutes.NETWORK_CHECK] = "NetworkCheckScreen"
        routes[AppRoutes.LOGIN_DECIDER] = "LoginDeciderScreen"
        routes[AppRoutes.SIGN_IN] = "SignInScreen"
        routes[AppRoutes.SIGN_UP] = "SignUpScreen"
        routes[AppRoutes.QR_AUTH] = "QRCodeScreen"

        return {
            initialRoute: AppRoutes.AUTH_CHECK
            routes: routes
        }
    end function
end namespace

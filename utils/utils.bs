function getAdConfigId(pageData)
    adConfigLevelValue = ""
    if isValidString(adConfigLevel())
        adConfigLevelValue = LCase(adConfigLevel())
    end if
    if pageData <> invalid and isValidString(pageData.adConfig) and (adConfigLevelValue = "media" or adConfigLevelValue = "globalandmedia")
        return pageData.adConfig
    else if adConfigLevelValue = "globalandmedia" or adConfigLevelValue = "global" and isValidString(m.global.adConfig)
        return m.global.adConfig
    end if
    return ""
end function

function adConfigLevel()
    if m.global.featureFlags <> invalid and m.global.featureFlags.ad_settings <> invalid and isValidString(m.global.featureFlags.ad_settings.ad_config_level) and LCase(m.global.featureFlags.ad_settings.ad_config_level) <> "none"
        return LCase(m.global.featureFlags.ad_settings.ad_config_level)
    else
        return ""
    end if
end function


function createAuthButton(title as string) as object
    button = CreateObject("roSGNode", "CustomButton")
    button.fixedWidth = 345
    button.fixedHeight = 75
    button.focusedFont = m.fonts.getFont(m.fontType.B3)
    button.unfocusedFont = m.fonts.getFont(m.fontType.B3)
    button.text = title
    button.loadComponent = true
    button.observeField("buttonSelected", "onButtonSelected")
    return button
end function

sub clearChildren(node as object)
    ' Defensive check
    if node = invalid then return

    numChildren = node.getChildCount()
    for i = numChildren - 1 to 0 step -1
        node.removeChild(node.getChild(i))
    end for
end sub

function getContentType(pageData as object) as string
if pageData = invalid or not isValidString(pageData.contentType)
        if isAudioPodcastItem(pageData) then return "podcast"
        return "movie"
    end if
    if pageData = invalid or not isValidString(pageData.contentType) then return "movie"
        contentType = LCase(pageData.contentType)
    if contentType = "series"
        return "series"
    else if contentType = "livechannel"
        return "live"
    else if contentType = "episode"
        return "episode"
    else if contentType = "liveevent"
        return "liveEvent"
    else if contentType = "hub"
        return "hub"
    else if contentType = "podcast" or contentType = "podcast_episode"
        return "podcast"
    else if contentType = "" and isAudioPodcastItem(pageData)
        return "podcast"
    else if contentType = "movie" or not isValidString(pageData.contentType)
        return "movie"
    else if contentType = "podcast_series"
        return "podcast_series"
    else if isValidString(pageData.tags) and Instr(0, pageData.tags, "movie") >= 0
        return "movie"
    end if
    return ""
end function

function isAudioPodcastItem(pageData as object) as boolean
    if pageData = invalid then return false
    if not isValidString(pageData.feedId) and not isValidString(pageData.feedid) then return false
    if isValidString(pageData.media_type) and LCase(pageData.media_type) = "audio" then return true
    if isVideoSourceFile(pageData.file, pageData.type) then return false
    if not arrayHasItems(pageData.sources) then return false

    for each source in pageData.sources
        if source <> invalid
            if isVideoSourceFile(source.file, source.type) then return false
            if isAudioSourceFile(source.file, source.type) then return true
        end if
    end for
    return false
end function

function isAudioSourceContent(pageData as object) as boolean
    if pageData = invalid then return false
    if isVideoSourceFile(pageData.file, pageData.type) then return false
    if isValidString(pageData.media_type) and LCase(pageData.media_type) = "audio" then return true
    if isValidString(pageData.mediaType) and LCase(pageData.mediaType) = "audio" then return true
    if isAudioSourceFile(pageData.file, pageData.type) then return true
    if not arrayHasItems(pageData.sources) then return false

    for each source in pageData.sources
        if source <> invalid
            if isVideoSourceFile(source.file, source.type) then return false
            if isAudioSourceFile(source.file, source.type) then return true
        end if
    end for
    return false
end function

function isAudioSourceFile(fileUrl as dynamic, mimeType as dynamic) as boolean
    if isValidString(mimeType) and Left(LCase(mimeType), 6) = "audio/" then return true
    return hasSourceExtension(fileUrl, ["mp3", "m4a", "m4b", "aac", "ogg", "oga", "opus", "wav", "flac", "weba", "wma"])
end function

function isVideoSourceFile(fileUrl as dynamic, mimeType as dynamic) as boolean
    if isValidString(mimeType)
        mimeType = LCase(mimeType)
        if Left(mimeType, 6) = "video/" or contains(mimeType, "mpegurl") or contains(mimeType, "dash+xml") then return true
    end if
    return hasSourceExtension(fileUrl, ["mp4", "m4v", "mpd", "m3u8", "mov", "mkv", "webm", "avi", "ts", "f4v", "flv", "3gp"])
end function

function hasSourceExtension(fileUrl as dynamic, extensions as object) as boolean
    if not isValidString(fileUrl) then return false
    cleanUrl = LCase(fileUrl)
    queryIndex = Instr(1, cleanUrl, "?")
    if queryIndex > 0 then cleanUrl = Left(cleanUrl, queryIndex - 1)
    dotIndex = 0
    for i = 1 to Len(cleanUrl)
        if Mid(cleanUrl, i, 1) = "." then dotIndex = i
    end for
    if dotIndex = 0 then return false
    extension = Right(cleanUrl, Len(cleanUrl) - dotIndex)
    for each supportedExtension in extensions
        if extension = supportedExtension then return true
    end for
    return false
end function

function isContentTypeMissing(item as object) as boolean
    if item = invalid then return true
    if not isValidString(item.contentType) then return true
    return LCase(item.contentType) = "null"
end function

' Hub-only: playable media with no content_type should skip Details and launch the player.
function shouldDirectPlayHubMedia(item as object) as boolean
    if item = invalid then return false
    if not isContentTypeMissing(item) then return false
    if isValidString(item.playlist) then return false
    if not isValidString(item.mediaId) then return false
    return isPlayableContent(item[getProductIdKey()], item.free)
end function

' Episodes (showCardDescription) or hub items with missing contentType — card description + More.
function itemShowsDirectPlayCardMore(item as object) as boolean
    if item = invalid then return false
    if item.subtype() <> "AssetDataModel" then return false
    if not isValidString(getLocaleText(item, "description")) then return false
    if checkBool(item.showCardDescription) then return true
    if checkBool(item.fromHub) and isContentTypeMissing(item) then return true
    return false
end function

function isMoreLinkFocused(item as object) as boolean
    if item = invalid then return false
    if item.subtype() <> "AssetDataModel" then return false
    return checkBool(item.moreLinkFocused)
end function

sub setMoreLinkFocused(item as object, focused as boolean)
    if item = invalid then return
    if item.subtype() <> "AssetDataModel" then return
    ' Changing moreLinkFocused can re-enter hub itemSelected; callers that own
    ' suppressItemSelected already cover tryFocus/clear. Guard here for Utils path.
    item.moreLinkFocused = focused
end sub

function buildCardMoreInfoData(item as object) as object
    if item = invalid then return invalid
    fonts = getFonts()
    fontType = m.global.font
    color = m.global.color
    labels = []
    title = getLocaleText(item, "title")
    if isValidString(title)
        labels.Push({
            id: "Title"
            width: 900
            maxLines: 3
            color: color.neutral_white
            font: fonts.getFont(fontType.S1)
            wrap: true
            lineSpacing: 1
            text: title
            opacity: 1.0
        })
    end if
    description = getLocaleText(item, "description")
    if isValidString(description)
        labels.Push({
            id: "Description"
            width: 800
            maxLines: 1
            color: color.neutral_400
            font: fonts.getFont(fontType.B4)
            wrap: true
            lineSpacing: 1
            text: stripHTML(description)
            opacity: 1.0
        })
    end if
    return {
        labels: labels
        itemSpacings: [24, 24]
        data: item
    }
end function

function FormatTime(seconds as integer) as string
    minutes = Int(seconds / 60)
    secs = seconds mod 60

    if minutes < 10 then
        minStr = "0" + stri(minutes)
    else
        minStr = stri(minutes)
    end if

    if secs < 10 then
        secStr = "0" + stri(secs)
    else
        secStr = stri(secs)
    end if

    return (minStr + ":" + secStr).Replace(" ", "")
end function

function GetImageHeight(width as integer, aspectRatio as string) as integer
    ratioParts = aspectRatio.split(":")
    if ratioParts.Count() = 2 then
        w = StrToI(ratioParts[0])
        h = StrToI(ratioParts[1])
        if w > 0 and h > 0 then
            return (width * h) / w
        end if
    end if
    return 630 ' Return 630 if aspect ratio is invalid
end function

function isCleeng() as boolean
    return isValidAA(m.global.cleeng)
end function

function isJwp() as boolean
    return isValidAA(m.global.jwp)
end function


import "pkg:/source/navigation/NavigationEvents.bs"
import "pkg:/source/navigation/AppRoutes.bs"
import "pkg:/source/rokuCore/LocalizationProvider.bs"

function createFont(uri as string, size as integer) as object
    font = CreateObject("roSGNode", "Font")
    font.uri = uri
    font.size = size
    return font
end function

sub init()
    m.image = m.top.findNode("mediaImage")
    m.video = m.top.findNode("featureVideo")
    m.title = m.top.findNode("screenTitle")
    m.subtitle = m.top.findNode("screenSubtitle")
    m.getStartedButton = m.top.findNode("getStartedButton")
    m.featureTitles = [
        m.top.findNode("featureTitle1")
        m.top.findNode("featureTitle2")
        m.top.findNode("featureTitle3")
    ]
    m.featureDescriptions = [
        m.top.findNode("featureDescription1")
        m.top.findNode("featureDescription2")
        m.top.findNode("featureDescription3")
    ]
    m.featureIcons = [
        m.top.findNode("featureIcon1")
        m.top.findNode("featureIcon2")
        m.top.findNode("featureIcon3")
    ]
     m.featureRows = [
        m.top.findNode("featureRow1")
        m.top.findNode("featureRow2")
        m.top.findNode("featureRow3")
    ]
    ' Fallback icons used when the config doesn't supply OB_ICON1..3
    m.defaultIcons = [
        RokuCore.GetAssetPath("images", "onboardIcon3")
        RokuCore.GetAssetPath("images", "onboardIcon2")
        RokuCore.GetAssetPath("images", "onboardIcon1")
    ]
    m.fonts = RokuCore.GetRuntimeConfiguration().theme.typography.fonts
    applyFonts()
    m.completionTask = m.top.findNode("completionTask")
    m.slides = []
    m.media = { type: "image", uri: "", fallbackImage: "" }
    m.configId = ""
    m.firebaseTheme = {}
    m.localizationStrings = {}
    m.globalNode = m.global
    if m.globalNode <> invalid then m.globalNode.observeField("localeCode", "onLocaleChanged")
    m.completionStarted = false
    m.getStartedButton.observeField("activated", "onGetStartedActivated")
    m.completionTask.observeField("requestState", "onCompletionStateChanged")
    m.video.observeField("state", "onVideoStateChanged")
    if m.top.navigationParams <> invalid then applyNavigationParams(m.top.navigationParams)
end sub

sub applyFonts()
    m.title.font = createFont(onboardingFont("semibold", "medium"), 56)
    m.subtitle.font = createFont(onboardingFont("medium", "regular"), 32)
    for index = 0 to 2
        m.featureTitles[index].font = createFont(onboardingFont("medium", "regular"), 36)
        m.featureDescriptions[index].font = createFont(onboardingFont("medium", "regular"), 24)
    end for
end sub

function onboardingFont(weight as string, fallbackWeight as string) as string
    uri = ""
    if m.fonts <> invalid then uri = stringValue(m.fonts[weight])
    if uri = "" and m.fonts <> invalid then uri = stringValue(m.fonts[fallbackWeight])
    return uri
end function

sub onNavigationParamsChanged(event as object)
    applyNavigationParams(event.getData())
end sub

sub applyNavigationParams(params as dynamic)
    if params = invalid then return
    m.slides = params.slides
    if m.slides = invalid then m.slides = []
    m.media = params.media
    if m.media = invalid then m.media = { type: "image", uri: "", fallbackImage: "" }
    m.configId = ""
    if params.configId <> invalid then m.configId = params.configId.ToStr()
    m.firebaseTheme = params.firebaseTheme
    if m.firebaseTheme = invalid then m.firebaseTheme = {}
    m.localizationStrings = params.localizationStrings
    if m.localizationStrings = invalid then m.localizationStrings = {}
    m.getStartedButton.localizationStrings = m.localizationStrings
    m.completionStarted = false
    renderOnboarding()
    m.top.isReady = m.slides.Count() > 0 or stringValue(m.media.uri) <> ""
end sub

sub renderOnboarding()
    strings = { strings: m.localizationStrings }
    m.title.text = RokuCore.GetLocalizedString(strings, ["ONBOARDING_SCREEN", "OB_HEADERTITLE"], "")
    m.subtitle.text = RokuCore.GetLocalizedString(strings, ["ONBOARDING_SCREEN", "OB_HEADERDESCRIPTION"], "")
    m.getStartedButton.text = RokuCore.GetLocalizedString(strings, ["ONBOARDING_SCREEN", "BUTTONS", "GET_STARTED_BUTTON"], "")
        for index = 0 to 2
        suffix = (index + 1).ToStr()
        title = RokuCore.GetLocalizedString(strings, ["ONBOARDING_SCREEN", "OB_TITLE" + suffix], "")
        description = RokuCore.GetLocalizedString(strings, ["ONBOARDING_SCREEN", "OB_DESCRIPTION" + suffix], "")

        ' Resolve each fallback icon from this build's market asset map.
        iconUri = stringValue(m.defaultIcons[index])
        m.featureIcons[index].uri = iconUri
        m.featureIcons[index].blendColor = &hFFFFFFFF
        m.featureIcons[index].visible = (iconUri <> "")

        m.featureTitles[index].text = title
        m.featureTitles[index].visible = (title <> "")
        m.featureDescriptions[index].text = description
        m.featureDescriptions[index].visible = (description <> "")

        ' A row with no text disappears and the rows below move up
        m.featureRows[index].visible = (title <> "" or description <> "")
    end for
    applyFirebaseButtonColors()
    renderMedia()
end sub

sub onLocaleChanged(event as object)
    m.localizationStrings = GetGlobalAA().strings
    if m.localizationStrings = invalid then m.localizationStrings = {}
    m.getStartedButton.localizationStrings = m.localizationStrings
    renderOnboarding()
end sub

sub applyFirebaseButtonColors()
    ' Clear any previous remote override so a later config can use the build preset.
    m.getStartedButton.gradientColors = invalid
    m.getStartedButton.gradientStops = invalid
    m.getStartedButton.gradientStyle = "none"
    m.getStartedButton.gradientAngle = 0

    gradients = m.firebaseTheme.gradients
    if gradients <> invalid
        primaryGradient = gradients.primary
        if primaryGradient <> invalid and primaryGradient.colors <> invalid
            if primaryGradient.colors.count() >= 2
                m.getStartedButton.gradientColors = primaryGradient.colors
                if primaryGradient.style <> invalid then m.getStartedButton.gradientStyle = primaryGradient.style
                if primaryGradient.angle <> invalid then m.getStartedButton.gradientAngle = primaryGradient.angle
                if primaryGradient.stops <> invalid then m.getStartedButton.gradientStops = primaryGradient.stops
                return
            end if
        end if
    end if

    ' No Firebase gradient was supplied; AppButton now resolves the build preset.
end sub

sub renderMedia()
    m.video.control = "stop"
    m.video.visible = false
    m.image.visible = false
    uri = stringValue(m.media.uri)
    if uri = "" then return

    mediaType = LCase(stringValue(m.media.type))
    if mediaType = "video"
        content = CreateObject("roSGNode", "ContentNode")
        content.url = uri
        content.streamFormat = streamFormatForUri(uri)
        m.video.content = content
        m.video.visible = true
        m.video.control = "play"
    else
        m.image.uri = uri
        m.image.visible = true
    end if
end sub

function streamFormatForUri(uri as string) as string
    cleanUri = LCase(uri)
    queryIndex = Instr(1, cleanUri, "?")
    if queryIndex > 0 then cleanUri = Left(cleanUri, queryIndex - 1)
    if Right(cleanUri, 5) = ".m3u8" then return "hls"
    if Right(cleanUri, 4) = ".mpd" then return "dash"
    return "mp4"
end function

sub onVideoStateChanged(event as object)
    state = event.getData()
    if state = "error"
        fallbackImage = stringValue(m.media.fallbackImage)
        if fallbackImage <> ""
            m.video.control = "stop"
            m.video.visible = false
            m.image.uri = fallbackImage
            m.image.visible = true
        else
            m.video.visible = false
        end if
    else if state = "finished" and not m.completionStarted
        m.video.seek = 0
        m.video.control = "play"
    end if
end sub

sub onGetStartedActivated(event as object)
    beginCompletion()
end sub

sub beginCompletion()
    if m.completionStarted then return
    m.completionStarted = true
    m.getStartedButton.enabled = false
    m.video.control = "stop"
    m.completionTask.configId = m.configId
    m.completionTask.control = "RUN"
end sub

sub onCompletionStateChanged(event as object)
    if event.getData() = "SUCCESS"
        scene = m.top.getScene()
        if scene <> invalid and scene.hasField("navigationEvent")
            events = new NavigationEvents()
            scene.navigationEvent = events.navigate(AppRoutes.AUTH_CHECK)
        end if
    else if event.getData() = "ERROR"
        m.completionStarted = false
        m.getStartedButton.enabled = true
        if LCase(stringValue(m.media.type)) = "video" then m.video.control = "play"
    end if
end sub

function setInitialFocus() as boolean
    m.getStartedButton.setFocus(true)
    return m.getStartedButton.hasFocus()
end function

sub onCleanupRequested(event as object)
    if not event.getData() then return
    m.getStartedButton.unobserveField("activated")
    if m.globalNode <> invalid then m.globalNode.unobserveField("localeCode")
    m.completionTask.unobserveField("requestState")
    m.video.unobserveField("state")
    m.video.control = "stop"
end sub

function stringValue(value as dynamic) as string
    if value = invalid then return ""
    valueType = LCase(type(value))
    if valueType <> "string" and valueType <> "rostring" then return ""
    return value
end function


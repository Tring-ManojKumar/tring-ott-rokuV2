{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "brightscript",
            "request": "launch",
            "name": "Rooibos Tests (Tringplay)",
            "rootDir": "${workspaceFolder}/.build-test",
            "files": ["**/*.*", "manifest"],
            "injectRdbOnDeviceComponent": true,
            "enableDebugProtocol": false,
            "rendezvousTracking": false,
            "preLaunchTask": "build:test",
            "envFile": "${workspaceFolder}/.env.prod",
            "host": "${env:ROKU_HOST}",
            "password": "${env:ROKU_PASS}"
        },
        {
            "type": "brightscript",
            "request": "launch",
            "name": "Tringplay (Prod)",
            "rootDir": "${workspaceFolder}/.build",
            "files": [
                "source/**/*.*",
                "componentLibraries/**/*.*",
                "components/**/*.*",
                "adapters/**/*.*",
                "config/**/*.*",
                "data/**/*.*",
                "domain/**/*.*",
                "enums/**/*.*",
                "images/**/*.*",
                "locale/**/*",
                "fonts/**/*",
                "managers/**/*.*",
                "services/**/*.*",
                "tasks/**/*.*",
                "utils/**/*.*",
                "assets/**/*",
                "manifest"
            ],
            "injectRdbOnDeviceComponent": true,
            "enableDebugProtocol": false,
            "preLaunchTask": "build:tringplay",
            "envFile": "${workspaceFolder}/.env.prod",
            "host": "${env:ROKU_HOST}",
            "password": "${env:ROKU_PASS}"
        },
        {
            "type": "brightscript",
            "request": "launch",
            "name": "Tringplay (Stage)",
            "rootDir": "${workspaceFolder}/.build",
            "files": [
                "source/**/*.*",
                "componentLibraries/**/*.*",
                "components/**/*.*",
                "adapters/**/*.*",
                "config/**/*.*",
                "data/**/*.*",
                "domain/**/*.*",
                "enums/**/*.*",
                "images/**/*.*",
                "locale/**/*",
                "fonts/**/*",
                "managers/**/*.*",
                "services/**/*.*",
                "tasks/**/*.*",
                "utils/**/*.*",
                "assets/**/*",
                "manifest"
            ],
            "injectRdbOnDeviceComponent": true,
            "enableDebugProtocol": true,
            "preLaunchTask": "build:tringplay:stage",
            "envFile": "${workspaceFolder}/.env.stage",
            "host": "${env:ROKU_HOST}",
            "password": "${env:ROKU_PASS}"
        },
        {
            "type": "brightscript",
            "request": "launch",
            "name": "B live (Prod)",
            "rootDir": "${workspaceFolder}/.build",
            "files": [
                "source/**/*.*",
                "componentLibraries/**/*.*",
                "components/**/*.*",
                "adapters/**/*.*",
                "config/**/*.*",
                "data/**/*.*",
                "domain/**/*.*",
                "enums/**/*.*",
                "images/**/*.*",
                "locale/**/*",
                "fonts/**/*",
                "managers/**/*.*",
                "services/**/*.*",
                "tasks/**/*.*",
                "utils/**/*.*",
                "assets/**/*",
                "manifest"
            ],
            "injectRdbOnDeviceComponent": true,
            "enableDebugProtocol": false,
            "preLaunchTask": "build:blive",
            "envFile": "${workspaceFolder}/.env.prod",
            "host": "${env:ROKU_HOST}",
            "password": "${env:ROKU_PASS}"
        },
        {
            "type": "brightscript",
            "request": "launch",
            "name": "B live (Stage)",
            "rootDir": "${workspaceFolder}/.build",
            "files": [
                "source/**/*.*",
                "componentLibraries/**/*.*",
                "components/**/*.*",
                "adapters/**/*.*",
                "config/**/*.*",
                "data/**/*.*",
                "domain/**/*.*",
                "enums/**/*.*",
                "images/**/*.*",
                "locale/**/*",
                "fonts/**/*",
                "managers/**/*.*",
                "services/**/*.*",
                "tasks/**/*.*",
                "utils/**/*.*",
                "assets/**/*",
                "manifest"
            ],
            "injectRdbOnDeviceComponent": true,
            "enableDebugProtocol": false,
            "preLaunchTask": "build:blive:stage",
            "envFile": "${workspaceFolder}/.env.stage",
            "host": "${env:ROKU_HOST}",
            "password": "${env:ROKU_PASS}"
        },
        {
            "type": "brightscript",
            "request": "launch",
            "name": "B live (Stage, Registry Diagnostics)",
            "rootDir": "${workspaceFolder}/.build",
            "files": [
                "source/**/*.*",
                "componentLibraries/**/*.*",
                "components/**/*.*",
                "adapters/**/*.*",
                "config/**/*.*",
                "data/**/*.*",
                "domain/**/*.*",
                "enums/**/*.*",
                "images/**/*.*",
                "locale/**/*",
                "fonts/**/*",
                "managers/**/*.*",
                "services/**/*.*",
                "tasks/**/*.*",
                "utils/**/*.*",
                "assets/**/*",
                "manifest"
            ],
            "injectRdbOnDeviceComponent": true,
            "enableDebugProtocol": false,
            "preLaunchTask": "build:blive:stage:debug",
            "envFile": "${workspaceFolder}/.env.stage",
            "host": "${env:ROKU_HOST}",
            "password": "${env:ROKU_PASS}"
        }
    ]
}

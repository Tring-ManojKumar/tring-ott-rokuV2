end sub

function isTokenValid(expiryDate) as boolean
    currentDate = CreateObject("roDateTime").AsSeconds()
    if expiryDate <> invalid
        return currentDate < expiryDate
    else
        return true
    end if
end function

function isDateInFuture(date) as boolean
    if isValidString(date)
        currentDate = CreateObject("roDateTime").AsSeconds()

        dateObj = CreateObject("roDateTime")
        dateObj.FromISO8601String(date)
        givenDate = dateObj.AsSeconds()

        return currentDate < givenDate
    end if
    return false
end function

function isEndDateInPast(date) as boolean
    if isValidString(date)
        currentDate = CreateObject("roDateTime").AsSeconds()

        dateObj = CreateObject("roDateTime")
        dateObj.FromISO8601String(date)
        givenDate = dateObj.AsSeconds()

        return currentDate > givenDate
    end if
    return false
end function

sub addUserTokenToRegistry(userDetails)
    idToken = ""
    if userDetails.idToken <> invalid
        idToken = userDetails.idToken
    end if
    userReg = {
        access_token: userDetails.access_token
        refresh_token: userDetails.refresh_token,
        idToken: idToken
    }
    if(userDetails.user <> invalid and userDetails.user.username <> invalid)
        userReg.ser_name = userDetails.user.username
    end if
    if(userDetails.expires <> invalid)
        userReg.ser_name = userDetails.expires
    end if
    writeToRegistry("user_token", FormatJson(userReg))
end sub

sub addUserTokenToRegistry1(userDetails, idToken = "")
    userReg = {
        access_token: userDetails.token,
        idToken: idToken
    }
    if(userDetails.user <> invalid and userDetails.user.username <> invalid)
        userReg.ser_name = userDetails.user.username
    end if
    writeToRegistry("user_token", FormatJson(userReg))
end sub

function getTitleContentNode(text) as object
    contentNode = CreateObject("roSGNode", "ContentNode")
    contentNode.TITLE = text
    return contentNode
end function

function createNoDataAvailableView(offset = invalid as object) as object
    if offset = invalid then offset = [0, 0]
    group = CreateObject("roSGNode", "LayoutGroup")
    group.setFields({
        layoutDirection: "vert"
        horizAlignment: "center"
        vertAlignment: "center"
        itemSpacings: [42, 12]
        translation: [960 - offset[0], 540 - offset[1]]
    })

    logo = CreateObject("roSGNode", "Poster")
    logoFields = {
        uri: "pkg:/images/app_icon.png"
        loadDisplayMode: "scaleToFit"
    }
    if m.global.style <> invalid and m.global.style.headerLogo <> invalid
        headerLogo = m.global.style.headerLogo
        if headerLogo.width <> invalid then logoFields.width = headerLogo.width
        if headerLogo.height <> invalid then logoFields.height = headerLogo.height
        if headerLogo.loadWidth <> invalid then logoFields.loadWidth = headerLogo.loadWidth
        if headerLogo.loadHeight <> invalid then logoFields.loadHeight = headerLogo.loadHeight
    end if
    logo.setFields(logoFields)
    group.appendChild(logo)

    message = m.strings.NO_DATA_AVAILABLE
    if not isValidString(message) then message = ""
    lines = message.Split(Chr(10))

    title = CreateObject("roSGNode", "Label")
    title.setFields({
        text: lines[0]
        font: m.fonts.getFont(m.fontType.S1)
        color: m.color.neutral_white
        horizAlign: "center"
    })
    group.appendChild(title)

    if lines.Count() > 1 and isValidString(lines[1])
        description = CreateObject("roSGNode", "Label")
        description.setFields({
            text: lines[1]
            font: m.fonts.getFont(m.fontType.S3)
            color: m.color.neutral_500
            horizAlign: "center"
            wrap: true
            width: 1400
            maxLines: 2
        })
        group.appendChild(description)
    end if
    return group
end function

function is12HourTimeFormat() as boolean
    format = invalid
    if m.global <> invalid and m.global.uiSettings <> invalid and isValidString(m.global.uiSettings.datetime_format)
        format = m.global.uiSettings.datetime_format
    else if m.global <> invalid and m.global.featureFlags <> invalid and isValidString(m.global.featureFlags.datetime_format)
        format = m.global.featureFlags.datetime_format
    end if
    if not isValidString(format) then return true
    return LCase(format) <> "24h"
end function

function formatTime12Hour(dateTimeObj as object) as string
    hours = dateTimeObj.getHours()
    minutes = dateTimeObj.getMinutes().ToStr()
    if Len(minutes) = 1 then minutes = "0" + minutes

    meridian = bsTernaryOperation(hours < 12, "AM", "PM")
    if m.global <> invalid and m.global.localeLanguage = "french"
        meridian = bsTernaryOperation(hours < 12, "du matin", "du soir")
    end if

    if hours = 0 then
        hours = 12
    else if hours > 12 then
        hours = hours - 12
    end if

    hoursStr = hours.ToStr()
    if Len(hoursStr) = 1 then hoursStr = "0" + hoursStr
    return hoursStr + ":" + minutes + " " + meridian
end function

function formatTime24Hour(dateTimeObj as object) as string
    hoursStr = dateTimeObj.getHours().ToStr()
    minutes = dateTimeObj.getMinutes().ToStr()
    if Len(minutes) = 1 then minutes = "0" + minutes
    if m.global <> invalid and m.global.localeLanguage = "french" then return hoursStr + " h " + minutes
    if Len(hoursStr) = 1 then hoursStr = "0" + hoursStr
    return hoursStr + ":" + minutes
end function

function formatClockTime(dateTimeObj as object) as string
    if is12HourTimeFormat() then return formatTime12Hour(dateTimeObj)
    return formatTime24Hour(dateTimeObj)
end function

function getFormattedTime(timeInSec) as string
    if isValidString(timeInSec)
        dateTimeObj = CreateObject("roDateTime")
        dateTimeObj.FromISO8601String(timeInSec)
        dateTimeObj.ToLocalTime()
        return formatClockTime(dateTimeObj)
    else
        return ""
    end if
end function

function formatVideoDuration(duration as longinteger, hourSuffix as string, minSuffix as string, secSuffix as string) as string
    if duration <= 0 then return ""
    if duration < 60 then return duration.ToStr() + secSuffix

    remainingSeconds = duration mod 60
    timeObj = CreateObject("roDateTime")
    timeObj.FromSeconds(duration)
    hours = timeObj.getHours()
    minutes = timeObj.getMinutes()
    if remainingSeconds > 30 then minutes++

    durationString = ""
    if hours > 0 then durationString += hours.ToStr() + hourSuffix
    if minutes > 0 then durationString += minutes.ToStr() + minSuffix
    return durationString.Trim()
end function

function getDuration(timeInSec) as string
    ' dateTimeObj = CreateObject("roDateTime")
    ' dateTimeObj.FromISO8601String(timeInSec)
    ' dateTimeObj.ToLocalTime()

    oneMinute = 60
    oneHour = oneMinute * 60
    oneDay = oneHour * 24
    oneMonth = oneDay * 30 ' Approximate month (30 days)
    oneYear = oneDay * 365 ' Approximate year (365 days) USD 19.99/One Month Access
    if timeInSec >= oneYear then
        years = timeInSec / oneYear
        return GetNumberWord(years) + " Year Access"
    else if timeInSec >= oneMonth then
        months = timeInSec / oneMonth
        return GetNumberWord(months) + " Month Access"
    else if timeInSec >= oneDay then
        days = timeInSec / oneDay
        return GetNumberWord(days) + " Days Access"
    else if timeInSec >= oneHour then
        hours = timeInSec / oneHour
        return GetNumberWord(hours) + " Hour Access"
    else if timeInSec >= oneMinute then
        minutes = timeInSec / oneMinute
        return GetNumberWord(minutes) + " Minute Access"
    else
        return GetNumberWord(timeInSec) + " Second Access"
    end if
end function

function GetNumberWord(num as integer) as string
    numberWords = [
        "One", "Two", "Three", "Four", "Five", "Six",
        "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen"
    ]

    if num >= 1 and num <= 15 then
        return numberWords[num - 1] ' Adjust for 0-based index
    else
        return "Invalid Number"
    end if
end function

function isPackageExpire(seconds) as boolean
    if isValidInteger(seconds)
        currentDate = CreateObject("roDateTime").AsSeconds()
        return currentDate > seconds
    end if
    return false
end function


function getFormattedDateTime(isoDate) as string
    if isValidString(isoDate)
        dateTimeObj = CreateObject("roDateTime")
        dateTimeObj.FromISO8601String(isoDate)
        dateTimeObj.ToLocalTime()
        date = getFrenchFullDate(dateTimeObj)
        return date + " " + Chr(183) + " " + formatClockTime(dateTimeObj)
    end if
    return ""
end function


function getFormattedDateTimeForLiveEvent(isoDate, endDateTitme)
    if isValidString(isoDate)
        dateTimeObj = CreateObject("roDateTime")
        dateTimeObj.FromISO8601String(isoDate)
        dateTimeObj.ToLocalTime()

        endDateTimeObj = CreateObject("roDateTime")
        endDateTimeObj.FromISO8601String(endDateTitme)
        endDateTimeObj.ToLocalTime()

        day = checkIfCurrentDateIsToday(dateTimeObj)
        return day + formatClockTime(dateTimeObj) + " – " + formatClockTime(endDateTimeObj)
    end if
    return ""
end function

function checkIfCurrentDateIsToday(dateTimeObj)
    ' Get the current date and time
    currentDateTime = dateTimeObj

    ' Get today's date
    todayDate = CreateObject("roDateTime")
    todayDate.ToISOString()
    todayDate.ToLocalTime()

    ' Compare year, month, and day
    if currentDateTime.GetYear() = todayDate.GetYear() and currentDateTime.GetMonth() = todayDate.GetMonth() and currentDateTime.GetDayOfMonth() = todayDate.GetDayOfMonth()
        if m.global.localeLanguage = "french" then return "Aujourd'hui, "
        return "Today, "
    else
        return getFrenchFullDate(dateTimeObj) + " " + Chr(183) + " "
    end if
end function

function getFrenchFullDate(dateTimeObj as object) as string
    monthNames = ["january", "february", "march", "april", "may", "june", "july", "august", "september", "october", "november", "december"]
    if m.global <> invalid and m.global.localeLanguage = "french"
        monthNames = ["janvier", "février", "mars", "avril", "mai", "juin", "juillet", "août", "septembre", "octobre", "novembre", "décembre"]
    end if
    monthIndex = dateTimeObj.GetMonth()
    if monthIndex < 1 or monthIndex > 12 then return dateTimeObj.AsDateString("no-weekday")
    return dateTimeObj.GetDayOfMonth().ToStr() + " " + monthNames[monthIndex - 1] + " " + dateTimeObj.GetYear().ToStr()
end function


function getAlternateThumbnail(item as object) as string
    if item <> invalid
        imageUrl = m.global.urls.alternateImageUrl
        if isValidString(imageUrl)
            if item.railType = "top-rated"
                label = "vertical"
            else
                label = item.railType
            end if
            return imageUrl.Replace("{{media-id}}", item.mediaId).Replace("{{label}}", label)
        end if
    end if
    return ""
end function

function getAlternateLogo(mediaId, label, size) as string
    if mediaId <> invalid and label <> invalid
        imageUrl = m.global.urls.alternateImageWithSize
        if isValidString(imageUrl)
            return imageUrl.Replace("{{media-id}}", mediaId).Replace("{{label}}", label).Replace("{{size}}", size)
        end if
    end if
    return ""
end function

function getHashValue(text as dynamic, mode = "sha1" as string) as string
    if isValidInteger(text) then text = text.ToStr()
    if isValidString(text)
        ba = CreateObject("roByteArray")
        ba.FromAsciiString(text)
        digest = CreateObject("roEVPDigest")
        digest.Setup(mode)
        return digest.Process(ba)
    end if
    return ""
end function

function generateId(length as integer) as string
    id = ""
    if length > 0
        for i = 0 to length - 1
            id += Rnd(9).ToStr()
        end for
    end if
    return id
end function

function getCurrentSnappedTime() as integer
    now = CreateObject("roDateTime").asSeconds()
    return now - (now mod 1800)
end function

sub exitApp()
    m.top.getScene().appExit = true
end sub

sub fireBeacon(event as string, canSendBeacon = false as boolean)
    m.top.pageAction = {
        type: "fireBeacon"
        canSendBeacon: canSendBeacon
        event: event
    }
end sub

function checkInternetStatus(forceCheck = false as boolean)
    deviceInfo = CreateObject("roDeviceInfo")
    if forceCheck then deviceInfo.ForceInternetStatusCheck()
    return deviceInfo.GetInternetStatus()
end function

function guardNetworkAction(action as Function, params = invalid as dynamic) as boolean
    if checkInternetStatus() then return true
    hideSpinner()
    m.pendingNetworkFn = action
    m.pendingNetworkParams = params
    if not m.global.hasField("pendingNetworkCaller")
        m.global.addField("pendingNetworkCaller", "node", false)
    end if
    m.global.pendingNetworkCaller = m.top
    m.top.pageAction = {
        type: "navigateToScreen"
        screenName: "ErrorScreen"
        data: {}
    }
    return false
end function

sub setGlobalConfigVariables(config)
    adScheduleUrl = ""
    clientId = "28a08b99-b9f5-4f4f-ba7d-b6b52e6db9f8"
    if config.integrations <> invalid and config.integrations.jwp <> invalid and isValidString(config.integrations.jwp.clientId)
        clientId = config.integrations.jwp.clientId
    end if
    if config.adScheduleUrls <> invalid and isValidString(config.adScheduleUrls.xml)
        adScheduleUrl = config.adScheduleUrls.xml
    end if
    cleeng = invalid
    jwp = invalid
    if config.integrations <> invalid and config.integrations.cleeng <> invalid
        cleeng = config.integrations.cleeng
    else if config.integrations <> invalid and config.integrations.jwp <> invalid
        jwp = config.integrations.jwp
    end if
   
    adMethod= getAdDeliveryMethod()
    ?"adMethod", adMethod
    ?"config adDeliveryMethod", config.adDeliveryMethod

    m.global.addFields({
        features: config.features
        
        adScheduleID: config.adSchedule
        adScheduleUrls: adScheduleUrl
        analyticsToken: config.analyticsToken
        custom: config.custom
        adConfig: config.adConfig
        siteId: config.siteId,
        clientId: clientId,
        adDeliveryMethod: adMethod,
        cleeng: cleeng,
        jwp: jwp
    })

    ?"m.global.adDeliveryMethod", m.global.adDeliveryMethod
    if m.global.adDeliveryMethod = invalid or m.global.adDeliveryMethod = ""
        m.global.adDeliveryMethod = config.adDeliveryMethod
    end if 
    
    if config.custom <> invalid
        m.global.addFields({
            advertising: {
                adEnabled: config.custom.adEnabled
            },
            contentProtection: {
                drm: { defaultPolicyId: config.custom.drmPolicyId },
                drmConfigId: config.custom.drmConfigId
                drmLiveMediaId: config.custom.drmLiveMediaId
                ' nonDrmLiveMediaId: config.custom.nonDrmLiveMediaId
            },
            ssaiAdsDRMContent:{
                siteId: config.custom.drmSiteId
                mediaId: config.custom.drmLiveMediaId
                drmPolicyId: config.custom.drmPolicyId
                drmAdConfigId: config.custom.drmAdConfigId
            }
        })
    end if
end sub

function ConvertBase64ToImage(base64QRImageUrl, code)
    cleanBase64String = base64QRImageUrl.Replace("data:image/png;base64,", "")
    ba = CreateObject("roByteArray")
    ba.fromBase64String(cleanBase64String)
    uri = "tmp:/qrImageUrl-" + code + ".png"
    ba = CreateObject("roByteArray")
    ba.fromBase64String(cleanBase64String)
    ba.writeFile(uri)
    return uri
end function

sub ConvertMillisecondsToSeconds(milliseconds as integer) as float
    ' Convert milliseconds to seconds
    seconds = milliseconds / 1000
    return seconds
end sub


'*******************************************************************
'**  Function to strip HTML tags from string
'*******************************************************************
function stripHTML(text as string) as object
    if type(text) = "String" or LCase(type(text)) = "rostring"
        r = createobject("roRegex", "&nbsp;", "m")
        text = r.replaceall(text, " ")


        'first get rid of initial paragraph marks
        r = createobject("roRegex", "<p>", "i")
        text = r.replaceall(text, ";eMTeR;;eMTeR;")

        'Replace ending paragaph marks with "&#xA;&#xA;"
        r = createobject("roRegex", "</p>", "i")
        text = r.replaceall(text, ";eMTeR;")

        r = createobject("roRegex", "&amp;", "i")
        text = r.replaceall(text, " & ")

        r = createobject("roRegex", "<br( )*/?>", "i")
        text = r.replaceall(text, ";eMTeR;;eMTeR;")
        r = createobject("roRegex", "&bull;", "i")
        text = r.replaceall(text, "*")
        r = createobject("roRegex", "&lsaquo;", "i")
        text = r.replaceall(text, "<")
        r = createobject("roRegex", "&rsaquo;", "i")
        text = r.replaceall(text, ">")
        r = createobject("roRegex", "&trade;", "i")
        text = r.replaceall(text, "tm)")
        r = createobject("roRegex", "&frasl;", "i")
        text = r.replaceall(text, "/")
        r = createobject("roRegex", "&lt;", "i")
        text = r.replaceall(text, "<")
        r = createobject("roRegex", "&gt;", "i")
        text = r.replaceall(text, ">")
        r = createobject("roRegex", "&copy;", "i")
        text = r.replaceall(text, "(c)")
        r = createobject("roRegex", "&reg;", "i")
        text = r.replaceall(text, "(r)")
        r = createobject("roRegex", "&rsquo;", "i")
        text = r.replaceall(text, "'")
        r = createobject("roRegex", "&rsquo;", "i")
        text = r.replaceall(text, "'")
        r = createobject("roRegex", "&mdash;", "i")
        text = r.replaceall(text, "-")
        'remove everything else
        r = createObject("roRegex", "&(.{2,6});", "i")
        text = r.replaceall(text, "")
        r = createObject("roRegex", "<b>", "i")
        text = r.replaceall(text, "")
        r = createObject("roRegex", "<i>", "i")
        text = r.replaceall(text, "")
        r = createObject("roRegex", "<u>", "i")
        text = r.replaceall(text, "")
        r = createobject("roRegex", "<div( )*/?>", "i")
        text = r.replaceall(text, "")
        r = createobject("roRegex", "</div>", "i")
        text = r.replaceall(text, "")

        r = createobject("roRegex", "<!--(.|\s)*?-->", "")
        text = r.replaceall(text, "")

        r = createobject("roRegex", "\\u200b", "m")
        text = r.replaceall(text, "")

        r = createobject("roRegex", "/[\x{200B}-\x{200D}]/u", "m")
        text = r.replaceall(text, "")


        r = createObject("roRegex", "<[^<]+?>", "i")
        text = r.replaceall(text, "")

        r = createObject("roRegex", "\n\n", "i")
        text = r.replaceall(text, ";eMTeR;")

        return text.trim()
    else
        return ""
    end if
end function

function lineBreak(strDesc)
    data = ""
    if strDesc <> invalid
        arrStr = strDesc.Split(";eMTeR;")

        for each strVal In arrStr
            data = data + strVal + chr(10)
        end for
    end if

    return data
end function


function scale(fromVal = 1 as integer) as dynamic
    dInfo = CreateObject("roDeviceInfo")
    mode = getDisplayMode()
    if mode = "FHD" then
        return (fromVal)
    else if mode = "HD" then 'FHD->HD:720/1080'
        return (fromVal)
    else if mode = "SD" then 'FHD->SD:480/1080'
        return (fromVal * 0.44444)
    end if
end function

function getDisplayMode() as string
    gaa = getGlobalAA()
    if gaa.displayMode = invalid then
        deviceinfo = CreateObject("roDeviceInfo")
        displaySize = deviceinfo.getDisplaySize()
        if displaySize.h = 1080
            gaa.displayMode = "FHD"
        else if displaySize.h = 720
            gaa.displayMode = "HD"
        else if displaySize.h = 480
            gaa.displayMode = "SD"
        end if
        return gaa.displayMode
    else
        return gaa.displayMode
    end if
end function

function GetWordCategory(paragraph as string) as integer
    wordArray = paragraph.Split(" ")
    wordCount = wordArray.Count()
    total = RoundOff(wordCount / 11)
    if total < 10
        return total
    else
        return 10
    end if
end function

function getLocaleText(data as object, key as string) as string
    if data <> invalid
        if m.global.localeLanguage = "english"
            newKey = key + "-en"
            if isValidString(data[newKey]) then return data[newKey]
        end if
        return data[key]
    end if
    return ""
end function

function getLocaleTextForRowlist(data as object, key as string, railContent = invalid) as string
    if data <> invalid
        if m.global.localeLanguage = "english"
            newKey = key + "-en"
            if isValidAA(data["custom"]) and isValidString(data["custom"][newKey]) then return data["custom"][newKey]
        end if
        if data[key] <> invalid
            return data[key]
        else
            return getLocaleText(railContent, "title")
        end if
    end if
    return ""
end function

sub updateConfig(userType)
    if isValidString(userType) then user_type = LCase(userType) else user_type = ""
    if m.global.urls <> invalid then
        if user_type = "kids" then
            m.global.urls.configID = m.global.urls.kidsConfigID
            ' if m.global.urls.submitButtonChange="submit"
            '      m.global.urls.configID = m.global.urls.kidsConfigID
            ' else
            '     m.global.urls.configID = m.global.urls.adultConfigID
            ' end if
        else
            if m.global.libraryUser.parentlibrary.libraryType = "public"
                m.global.urls.configID = m.global.urls.publicAdultConfigID
            else
                m.global.urls.configID = m.global.urls.adultConfigID
            end if

        end if
        m.global.urls.configUrl = getContentBaseUrl() + m.global.urls.configUrl.Replace("{{config-id}}", getAppConfigId())
        writeToRegistry("configUrl", m.global.urls.configUrl)
    end if
end sub


function ApplyNodeEffect(target as object, radius as float, borderWidth as float, borderColor as integer, gradientColors as dynamic, gradientStops as dynamic, gradientStyle as string, gradientAngle as float) as boolean
    if target = invalid then return false
    if not target.hasField("effect") then return false

    ' Effect nodes exist from Roku OS 16; check once per component
    if m.effectPlatformOk = invalid then m.effectPlatformOk = CheckEffectPlatform()
    if not m.effectPlatformOk
        target.effect = invalid
        return false
    end if

    effect = target.effect
    effectNodeName = "Effect"
    isNew = false
    if effect = invalid
        effect = CreateObject("roSGNode", effectNodeName)
        if effect = invalid then return false
        if not effect.supported
            m.effectPlatformOk = false
            return false
        end if
        isNew = true
    end if

    effect.borderRadius = [radius]
    effect.borderWidth = borderWidth
    effect.borderColor = borderColor
    effect.borderPadding = 0

    hasGradient = false
    if gradientColors <> invalid
        if gradientColors.count() >= 2 then hasGradient = true
    end if
    if hasGradient
        if gradientStyle = "none" then hasGradient = false
    end if

    if hasGradient
        effect.gradientColors = ToEffectColors(gradientColors)
        effect.gradientStyle = gradientStyle
        effect.gradientAngle = gradientAngle
        effect.gradientFillContent = true
        effect.gradientFillBorder = false
        stops = []
        if gradientStops <> invalid
            if gradientStops.count() = gradientColors.count() then stops = gradientStops
        end if
        effect.gradientStops = stops
    else
        effect.gradientStyle = "none"
        effect.gradientColors = []
        effect.gradientStops = []
    end if

    if isNew then target.effect = effect
    return true
end function

function ToEffectColors(values as object) as object
    result = []
    for each value in values
        if type(value) = "Integer"
            result.push(value)
        else
            result.push(ThemeColor(value.toStr()))
        end if
    end for
    return result
end function

function CheckEffectPlatform() as boolean
    osVersion = CreateObject("roDeviceInfo").GetOSVersion()
    if osVersion = invalid then return false
    if osVersion.major = invalid then return false
    return Val(osVersion.major) >= 16
end function
        return m.global.platforms <> invalid and isValidBool(m.global.platforms.is_deeplink_tracking_enabled) and m.global.platforms.is_deeplink_tracking_enabled
    end if
end function

function isVersionMatched() as boolean
    if m.global.buildVersion = invalid then return false
    if m.global.platforms = invalid then return false
    if m.global.platforms.build_version = invalid then return false
    if m.global.platforms.build_version.version = invalid then return false
    localVersion = Val(m.global.buildVersion)
    remoteVersion = m.global.platforms.build_version.version
    if (localVersion = remoteVersion)
        return true
    else
        return false
    end if
end function

function isAnalyticsEventEnabled() as boolean
    return m.global.featureFlags <> invalid and checkBool(m.global.featureFlags.is_analytics_enabled)
end function

function isGa4ProviderEnabled() as boolean
    if m.global.analyticsConfig = invalid or m.global.analyticsConfig.analytics = invalid then return true
    providers = m.global.analyticsConfig.analytics.providers
    if not arrayHasItems(providers) then return true
    for each provider in providers
        if isValidString(provider) and UCase(provider) = "GA4" then return true
    end for
    return false
end function

function isAnalyticsConfigEventEnabled(eventName as string) as boolean
    if not isValidString(eventName) then return true
    if m.global.analyticsConfig = invalid or m.global.analyticsConfig.analytics = invalid then return true
    events = m.global.analyticsConfig.analytics.events
    if events = invalid or events[eventName] = invalid then return true
    return checkBool(events[eventName].enabled)
end function

function filterAnalyticsEventParameters(eventName as string, params as object) as object
    if params = invalid then return {}
    if not isValidString(eventName) then return params
    if m.global.analyticsConfig = invalid or m.global.analyticsConfig.analytics = invalid then return params
    events = m.global.analyticsConfig.analytics.events
    if events = invalid or events[eventName] = invalid then return params
    allowed = events[eventName].parameters
    if not arrayHasItems(allowed) then return params
    filtered = {}
    for each key in allowed
        if params.DoesExist(key) then filtered[key] = params[key]
    end for
    if eventName = "scroll_horizontal"
        for each key in ["playlist_name"]
            if params.DoesExist(key) then filtered[key] = params[key]
        end for
    else if eventName = "video_play"
        for each key in ["video_title", "current_position", "video_progress"]
            if params.DoesExist(key) then filtered[key] = params[key]
        end for
    else if eventName = "video_rewind" or eventName = "video_forward"
        for each key in ["current_position", "video_progress"]
            if params.DoesExist(key) then filtered[key] = params[key]
        end for
    else if eventName = "search_result_clicked" or eventName = "search_result_impression"
        if params.DoesExist("video_id") then filtered.video_id = params.video_id
    end if
    if Left(eventName, 6) = "video_" and params.DoesExist("biznumber")
        filtered.biznumber = params.biznumber
    end if
    return filtered
end function

function appendAnalyticsBiznumber(params as object, content as object) as object
    if params <> invalid and content <> invalid and isValidString(content.biznumber)
        params.biznumber = content.biznumber
    end if
    return params
end function

function getAnalyticsIsoTimestamp() as string
    dateTime = CreateObject("roDateTime")
    month = dateTime.GetMonth().ToStr()
    day = dateTime.GetDayOfMonth().ToStr()
    hour = dateTime.GetHours().ToStr()
    minute = dateTime.GetMinutes().ToStr()
    second = dateTime.GetSeconds().ToStr()

    if month.Len() = 1 then month = "0" + month
    if day.Len() = 1 then day = "0" + day
    if hour.Len() = 1 then hour = "0" + hour
    if minute.Len() = 1 then minute = "0" + minute
    if second.Len() = 1 then second = "0" + second

    return dateTime.GetYear().ToStr() + "-" + month + "-" + day + "T" + hour + ":" + minute + ":" + second + "Z"
end function


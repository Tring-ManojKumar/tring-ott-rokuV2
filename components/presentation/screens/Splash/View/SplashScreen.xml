<?xml version="1.0" encoding="UTF-8" ?>
<component name="SplashScreen" extends="Group">
    <interface>
        <field id="splashConfig" type="assocarray" onChange="onSplashConfigChanged" />
    </interface>
    <children>
        <Rectangle id="background" width="1920" height="1080" color="0x000000FF" />
        <Poster id="brand" translation="[760, 390]" width="400" height="300" loadDisplayMode="scaleToFit" visible="false" />
        <Video id="brandVideo" width="1920" height="1080" visible="false" enableUI="false" />
        <Label id="loading" translation="[0, 750]" width="1920" height="60" horizAlign="center" text="Loading…" color="0xFFFFFFFF" font="font:MediumSystemFont" />
    </children>
</component>

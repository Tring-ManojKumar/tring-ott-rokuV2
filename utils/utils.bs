sub deleteHistory(contentID as string)
    if isValidString(contentID)
        history = getHistory()
        deleteIndex = -1
        for i = 0 to history.count() - 1
            item = history[i]
            if item.mediaid = contentId
                deleteIndex = i
            end if
        end for
        if deleteIndex > -1
            history.Delete(deleteIndex)
        end if
        m.global.Update({
            history: history
        }, true)
    end if
end sub

function getHistory() as object

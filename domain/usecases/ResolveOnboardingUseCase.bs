import "pkg:/source/rokuCore/ConfigurationProvider.bs"

namespace Domain
    class ResolveOnboardingUseCase
        private repository as object

        function new(repository as object)
            m.repository = repository
        end function

        function execute(resolvedConfiguration as dynamic, marketFlags = invalid as dynamic) as object
            if resolvedConfiguration = invalid then return { enabled: false, completed: false, shouldShow: false, slides: [] }
            platforms = resolvedConfiguration.platforms
            flags = resolvedConfiguration.featureFlags
            if flags = invalid then flags = {}
            enabled = m.toBoolean(flags.is_onboarding_screen_enabled)

            if platforms <> invalid and platforms.build_version <> invalid
                buildVersion = platforms.build_version.version
                if m.isVersionMatched(buildVersion) and platforms.build_version.is_onboarding_screen_enabled <> invalid
                    enabled = m.toBoolean(platforms.build_version.is_onboarding_screen_enabled)
                else if platforms.is_onboarding_screen_enabled <> invalid
                    enabled = m.toBoolean(platforms.is_onboarding_screen_enabled)
                end if
            else if platforms <> invalid and platforms.is_onboarding_screen_enabled <> invalid
                enabled = m.toBoolean(platforms.is_onboarding_screen_enabled)
            end if

            configId = ""
            if resolvedConfiguration.configId <> invalid then configId = resolvedConfiguration.configId.ToStr()

            slides = []
            rokuConfig = resolvedConfiguration.rokuConfig
            if rokuConfig <> invalid and m.isArray(rokuConfig.onBoarding) and rokuConfig.onBoarding.Count() > 0
                slides = rokuConfig.onBoarding
            else if platforms <> invalid and m.isArray(platforms.onBoarding)
                slides = platforms.onBoarding
            end if

            if slides.Count() = 0 then slides = m.slidesFromMarketFlags(marketFlags)

            if slides.Count() = 0 and configId = "ffuxvbfv"
                slides = m.defaultTringPlaySlides()
            end if

            media = m.resolveMedia(resolvedConfiguration, marketFlags, slides)
            completed = false
            if configId <> "" then completed = m.repository.hasCompletedOnboarding(configId)
            hasOnboardingContent = slides.Count() > 0 or media.uri <> ""
            return { enabled: enabled, completed: completed, shouldShow: enabled and not completed and hasOnboardingContent, slides: slides, media: media, configId: configId }
        end function

        private function resolveMedia(resolvedConfiguration as dynamic, marketFlags as dynamic, slides as object) as object
            rokuConfig = resolvedConfiguration.rokuConfig
            platforms = resolvedConfiguration.platforms
            remote = resolvedConfiguration.remote

            onboardingVideo = ""
            if rokuConfig <> invalid then onboardingVideo = m.stringValue(rokuConfig.onboarding_video)
            if onboardingVideo = "" and platforms <> invalid then onboardingVideo = m.stringValue(platforms.onboarding_video)
            if onboardingVideo = "" and remote <> invalid then onboardingVideo = m.stringValue(remote.onboarding_video)
            if onboardingVideo = "" then onboardingVideo = m.stringValue(resolvedConfiguration.onboarding_video)

            fallbackImage = m.onboardingImage(marketFlags, slides)
            if onboardingVideo <> ""
                return { type: "video", uri: onboardingVideo, fallbackImage: fallbackImage }
            end if

            splashVideo = m.splashVideo(marketFlags)
            if splashVideo <> ""
                return { type: "video", uri: splashVideo, fallbackImage: fallbackImage }
            end if

            return { type: "image", uri: fallbackImage, fallbackImage: "" }
        end function

        private function splashVideo(marketFlags as dynamic) as string
            flagsAssets = invalid
            if marketFlags <> invalid then flagsAssets = marketFlags.assets
            video = ""
            if flagsAssets <> invalid then video = m.stringValue(flagsAssets.splash_video)
            if video = "" and flagsAssets <> invalid and flagsAssets.images <> invalid
                video = m.stringValue(flagsAssets.images.splash_video)
            end if

            runtime = RokuCore.GetRuntimeConfiguration()
            runtimeAssets = invalid
            if runtime <> invalid then runtimeAssets = runtime.assets
            if video = "" and runtimeAssets <> invalid then video = m.stringValue(runtimeAssets.splash_video)
            if video = "" and runtimeAssets <> invalid and runtimeAssets.images <> invalid
                video = m.stringValue(runtimeAssets.images.splash_video)
            end if
            if video = "" then video = m.stringValue(RokuCore.GetAssetPath("images", "splash_video"))
            return video
        end function

        private function onboardingImage(marketFlags as dynamic, slides as object) as string
            image = ""
            if marketFlags <> invalid
                image = m.firstArrayValue(marketFlags.onboardingImage)
                if image = "" and marketFlags.images <> invalid
                    image = m.firstArrayValue(marketFlags.images.onboardingImage)
                end if
                if image = "" and marketFlags.assets <> invalid
                    image = m.firstArrayValue(marketFlags.assets.onboardingImage)
                end if
                if image = "" and marketFlags.assets <> invalid
                    if marketFlags.assets.images <> invalid
                        image = m.firstArrayValue(marketFlags.assets.images.onboardingImage)
                    end if
                end if
            end if

            runtime = RokuCore.GetRuntimeConfiguration()
            if image = "" and runtime <> invalid and runtime.assets <> invalid
                image = m.firstArrayValue(runtime.assets.onboardingImage)
                if image = "" and runtime.assets.images <> invalid
                    image = m.firstArrayValue(runtime.assets.images.onboardingImage)
                end if
            end if
            if image = "" then image = m.stringValue(RokuCore.GetAssetPath("images", "onboardingImage"))
            if image = "" and slides.Count() > 0
                image = m.stringValue(slides[0].image_uri)
                if image = "" then image = m.stringValue(slides[0].imageUri)
            end if
            if image = "" and marketFlags <> invalid and marketFlags.images <> invalid
                image = m.stringValue(marketFlags.images.onBording1)
            end if
            return image
        end function

        private function firstArrayValue(value as dynamic) as string
            if m.isArray(value)
                if value.Count() > 0 then return m.stringValue(value[0])
                return ""
            end if
            return m.stringValue(value)
        end function

        private function stringValue(value as dynamic) as string
            if value = invalid then return ""
            valueType = LCase(type(value))
            if valueType <> "string" and valueType <> "rostring" then return ""
            return value.Trim()
        end function

        private function slidesFromMarketFlags(marketFlags as dynamic) as object
            slides = []
            if marketFlags = invalid or marketFlags.images = invalid then return slides
            images = marketFlags.images
            imageUris = [images.onBording1, images.onBording2, images.onBording3]
            titles = ["Live Streaming", "The Latest", "On-Demand"]
            descriptions = [
                "Stream news, weather, live sports, & more for free 24/7.",
                "Local news, weather & sports from KSL TV.",
                "The best of KSL, when it fits your schedule."
            ]
            for index = 0 to imageUris.Count() - 1
                if imageUris[index] = invalid or imageUris[index].ToStr().Trim() = "" then return []
                slides.Push({
                    localizationKey: "PAGE_" + (index + 1).ToStr()
                    image_uri: imageUris[index].ToStr()
                    page_title: titles[index]
                    page_description: descriptions[index]
                })
            end for
            return slides
        end function

        private function defaultTringPlaySlides() as object
            return [
                {
                    localizationKey: "PAGE_1"
                    image_uri: "pkg:/assets/images/onboarding-page-1.png"
                    page_title: "Instant access without waiting"
                    page_description: "Start watching immediately with no delays."
                },
                {
                    localizationKey: "PAGE_2"
                    image_uri: "pkg:/assets/images/onboarding-page-2.png"
                    page_title: "Live TV channel streaming"
                    page_description: "Watch real-time broadcasts on demand anytime."
                },
                {
                    localizationKey: "PAGE_3"
                    image_uri: "pkg:/assets/images/onboarding-page-3.png"
                    page_title: "Ultra HD video quality"
                    page_description: "Experience stunning high resolution visual content."
                }
            ]
        end function

        private function isVersionMatched(remoteVersion as dynamic) as boolean
            if remoteVersion = invalid then return false
            localVersion = RokuCore.GetAppBuildVersion()
            if localVersion = "" then return false
            return Val(localVersion) = Val(remoteVersion.ToStr())
        end function

        private function isArray(value as dynamic) as boolean
            if value = invalid then return false
            valueType = LCase(type(value))
            return valueType = "roarray" or valueType = "array"
        end function

        private function toBoolean(value as dynamic) as boolean
            if value = invalid then return false
            valueType = LCase(type(value))
            if valueType = "boolean" or valueType = "roboolean" then return value
            if valueType = "integer" or valueType = "roint" then return value <> 0
            if valueType = "string" or valueType = "rostring"
                return LCase(value.Trim()) = "true"
            end if
            return false
        end function
    end class
end namespace

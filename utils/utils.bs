    if m.global.firebaseCleeng.publisher_token <> invalid
        return m.global.firebaseCleeng.publisher_token
    end if
    return "ZaqMQZBqxHSJPQdlp0rxRYgcsaX5b23DSwOLm1D7ZcxlwKZD"
end function

function getCleengMaxNoOfContinueWatching() as integer
    if m.global.firebaseCleeng.max_no_of_continue_watching <> invalid
        if isValidString(m.global.firebaseCleeng.max_no_of_continue_watching)
            return m.global.firebaseCleeng.max_no_of_continue_watching.toInt()
        else
            return m.global.firebaseCleeng.max_no_of_continue_watching
        end if
    end if

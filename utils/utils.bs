function isOnboardingScreenEnabled() as boolean
    if isVersionMatched()
        return m.global.platforms.build_version.is_onboarding_screen_enabled
    end if
    globalConfigOnboarding = m.global.featureFlags <> invalid and isValidBool(m.global.featureFlags.is_onboarding_screen_enabled) and m.global.featureFlags.is_onboarding_screen_enabled
    if m.global.platforms <> invalid and m.global.platforms.is_onboarding_screen_enabled <> invalid
        rokuPlatformOnboarding = m.global.platforms <> invalid and isValidBool(m.global.platforms.is_onboarding_screen_enabled) and m.global.platforms.is_onboarding_screen_enabled
        return rokuPlatformOnboarding
    end if
    return globalConfigOnboarding
end function


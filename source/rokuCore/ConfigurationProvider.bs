import "pkg:/utils/logging/Logger.bs"

namespace RokuCore
    function GetMarketFlags() as object
        raw = ReadAsciiFile("pkg:/assets/config/flags.json")
        if raw = invalid or raw = "" then return {}
        flags = ParseJson(raw)
        if flags = invalid or not IsConfigurationAssociativeArray(flags)
            AppLogError("ConfigurationProvider", "Packaged market flags are invalid")
            return {}
        end if
        return flags
    end function

    function GetRuntimeConfiguration() as object
        raw = ReadAsciiFile("pkg:/config/config.json")
        if raw = invalid or raw = "" then return {}
        configuration = ParseJson(raw)
        if configuration = invalid or not IsConfigurationAssociativeArray(configuration) then return {}
        return configuration
    end function

    function GetAppBuildVersion() as string
        return GetBuildVersionFromManifest(ReadAsciiFile("pkg:/manifest"))
    end function

    function GetBuildVersionFromManifest(manifestText as dynamic) as string
        if manifestText = invalid then return ""
        prefix = "build_version="
        for each line in manifestText.ToStr().Tokenize(Chr(10))
            line = line.Trim()
            if LCase(Left(line, prefix.Len())) = prefix
                return Mid(line, prefix.Len() + 1).Trim()
            end if
        end for
        return ""
    end function

    function GetApiConfiguration() as object
        configuration = GetRuntimeConfiguration()
        if configuration.api = invalid or not IsConfigurationAssociativeArray(configuration.api) then return {}
        return configuration.api
    end function

    function GetApiEndpoint(endpointName as string) as dynamic
        api = GetApiConfiguration()
        if api.endpoints = invalid
            if endpointName = "playlist" and api.defaultPlaylistUrl <> invalid then return api.defaultPlaylistUrl
            return api[endpointName + "Url"]
        end if
        return api.endpoints[endpointName]
    end function

    function GetApiBaseUrl(name as string) as dynamic
        api = GetApiConfiguration()
        if api.baseUrls = invalid
            if name = "content" then return api.contentBaseUrls
            return invalid
        end if
        return api.baseUrls[name]
    end function

    function ResolveEnvironmentBaseUrl(section as dynamic, environment as string) as dynamic
        if section = invalid then return invalid
        valueType = LCase(type(section))
        if valueType = "string" or valueType = "rostring" then return section
        if not IsConfigurationAssociativeArray(section) then return invalid
        normalized = LCase(environment.Trim())
        key = "sandBox"
        if normalized = "prod" or normalized = "production" then key = "prod"
        selected = section.lookup(key)
        if selected = invalid
            if key = "prod" then selected = section.lookup("sandBox") else selected = section.lookup("prod")
        end if
        if selected = invalid then return invalid
        valueType = LCase(type(selected))
        if valueType = "string" or valueType = "rostring" then return selected
        return invalid
    end function

    function GetApiRoute(routeName as string) as dynamic
        api = GetApiConfiguration()
        if api.routes = invalid then return api[routeName]
        return api.routes[routeName]
    end function

    ' Asset maps are resolved at build time to final pkg:/assets/... paths.
    function GetAssetPath(category as string, logicalKey as string) as dynamic
        configuration = GetRuntimeConfiguration()
        if configuration.assets = invalid then return invalid
        if configuration.assets[category] = invalid then return invalid
        return configuration.assets[category][logicalKey]
    end function

    function IsConfigurationAssociativeArray(value as dynamic) as boolean
        if value = invalid then return false
        return type(value) = "roAssociativeArray"
    end function
end namespace
